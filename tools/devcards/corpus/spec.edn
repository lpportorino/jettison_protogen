  "Card/child/wrapper :props keys. Style-slot keys map 1:1 onto conventions :style-prop-slots; :*_props keys are the WidgetNode widget-props oneof messages, field names verbatim from ui_ast.proto."
  :flex-flow :PROP_FLEX_FLOW
  :h :PROP_HEIGHT
  :pad-all :PROP_PAD_ALL
  :radius :PROP_RADIUS
