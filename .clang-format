# Canonical C style for the renderer's hand-authored sources.
#
# KEYS ARE BYTE-IDENTICAL TO ~/git/cc/sych/.clang-format ON PURPOSE. One C style
# across the fleet means a file moved between repos does not reformat, and a
# reviewer reading two repos reads one layout. Change a key here only in lockstep
# with sych.
#
# The load-bearing keys make clang-format IDEMPOTENT — format(format(x)) ==
# format(x) — so the formatted tree is a fixed point and drift is detectable:
#   DerivePointerAlignment: false  — output must not depend on input layout
#                                    (deriving it defeats canonicalisation).
#   MaxEmptyLinesToKeep: 0         — drop discretionary author blank lines,
#   SeparateDefinitionBlocks: Always — then re-add them deterministically, so
#                                    blank lines become INPUT-INDEPENDENT.
#   InsertNewlineAtEOF: true       — exactly one trailing newline, always.
#   UseTab: Never                  — tabs are layout; spaces only.
#
# HOW THIS MUST BE CHECKED — this bit is not optional. `clang-format --dry-run
# --Werror` DISAGREES with `clang-format -i` under the MaxEmptyLinesToKeep:0 +
# SeparateDefinitionBlocks:Always pairing: after `-i` converges, --dry-run still
# reports edits it will never make (measured: 130 on renderer.c, 18 on theme.c,
# stable across repeated -i passes). Checking with --dry-run therefore fails
# forever on a correctly-formatted tree. The gate must instead compare the
# formatter's OUTPUT against the file (see `fmt-c` in lint.mk) — which is also
# the more honest question: "is the committed file what the formatter produces?"
#
# NOT formatted (never handed to the tool — see FMT_C_FILES in lint.mk):
#   renderer/lvgl/**        vendored upstream, byte-exact per .gitattributes
#   renderer/generated/**   nanopb + threshold projections
#   renderer/src/font_*.c   generated LVGL font data
BasedOnStyle: LLVM
ColumnLimit: 80
DerivePointerAlignment: false
MaxEmptyLinesToKeep: 0
SeparateDefinitionBlocks: Always
InsertNewlineAtEOF: true
UseTab: Never
ReflowComments: false
