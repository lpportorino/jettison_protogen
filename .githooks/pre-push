#!/usr/bin/env bash
# pre-push — the FAST local gate: formatting + lint over hand-authored code.
#
# BEST-EFFORT AUTO-FIX, then BLOCK. Formatting is mechanical and deterministic,
# so making a human re-run `fmt-fix` after a red gate is pure friction: this
# hook applies it for you. It then FAILS the push anyway, always, because a
# pre-push hook cannot change what is being pushed — the commits already exist,
# and rewriting files afterwards leaves the unformatted versions in the objects
# git is about to send. So a rewrite MUST block; letting the push through would
# ship exactly the code the gate rejected. Commit the rewrite and push again.
#
# WHAT IS AUTO-FIXED — the formatters only:
#   cljfmt         yes, deterministic.
#   clang-format   yes, but ONLY through the pinned WASI-SDK binary in the uber
#                  container. Without docker the C lane drops to check-only:
#                  formatting C with an unpinned clang-format would rewrite the
#                  tree into something CI rejects, manufacturing the very drift
#                  this gate exists to prevent.
#
# WHAT IS NOT — the linters report, they never rewrite:
#   clj-kondo      has no autofix at all.
#   splint         HAS `--autocorrect`, and it was measured on this tree and
#                  rejected: it dropped a load-bearing comment, exploded
#                  readable `str` calls to one argument per line, flattened
#                  aligned map literals, and emitted a fully-qualified
#                  `clojure.string/join` into a namespace that does not require
#                  clojure.string — output our OWN clj-kondo gate then failed
#                  on. An autofix whose output the next gate rejects is not a
#                  time-saver. See lint.mk `splint-clj`.
#
# The full proof battery (wasm build, devcards render, oracles) needs the pinned
# container and minutes of wall clock; that stays in CI, which is the
# AUTHORITATIVE gate. This hook exists so the public trunk does not go red for a
# stale import or an unformatted file — protogen is pinned by a consumer fleet,
# and a red trunk is everyone's problem.
#
# It is NOT a substitute for CI: a client-side hook only protects whoever armed
# it, and `--no-verify` bypasses it. CI protects the consumers regardless.
#
# Arm with:  make -f lint.mk install-hooks   (sets core.hooksPath)
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

printf '\033[36m[pre-push]\033[0m format + lint gates\n'

# A DIRTY tree is not auto-fixed. `fmt-fix` walks whole paths, so it would
# reformat unrelated work-in-progress and entangle it with the formatter's
# output — and "read the diff and commit it" stops being a safe instruction the
# moment half the diff is yours. Check-only is the honest fallback.
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
  printf '\033[33m[pre-push]\033[0m working tree dirty — checking only, not auto-fixing\n'
  autofix=0
else
  autofix=1
fi

if [ "$autofix" = 1 ]; then
  printf '\033[36m[pre-push]\033[0m applying formatters…\n'
  make -f lint.mk fmt-clj-fix >/dev/null 2>&1 || true
  if command -v docker >/dev/null 2>&1; then
    tools/uber.sh 'make -f lint.mk fmt-c-fix' >/dev/null 2>&1 || true
  else
    printf '\033[33m[pre-push]\033[0m no docker — C left unformatted (pinned clang-format unavailable)\n'
  fi

  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    printf '\033[33m[pre-push]\033[0m BLOCKED — formatting was applied to:\n' >&2
    git status --porcelain | sed 's/^/  /' >&2
    cat >&2 <<'EOF'

Those rewrites are NOT in the commits you are pushing — a hook cannot amend
what git has already prepared for transfer. Read the diff, commit it, push
again:

    git diff            # what the formatter changed
    git commit -am '…'  # or amend, if the pushed commit is yours and unshared
    git push

EOF
    exit 1
  fi
fi

if ! make -f lint.mk lint; then
  cat >&2 <<'EOF'

[pre-push] BLOCKED — the gate is red on something no formatter can fix.

  see the lint findings   :  make -f lint.mk lint-clj
  format C without docker :  install docker, or leave it to CI

A gate failure is a thing to FIX, not to skip. `git push --no-verify` exists
and is yours to use, but it pushes the failure onto the consumer fleet.
EOF
  exit 1
fi

# CLANG-TIDY over the hand-authored C. Separate from `lint` for a MECHANICAL
# reason rather than a semantic one: it is the only lane that cannot run on the
# host at all. It needs run-clang-tidy from the pinned WASI-SDK plus a compile
# database emitted from the build's own flags, so folding it into `lint-lanes`
# would hard-fail every push from a machine without the image — and `lint` is
# invoked bare above, not through tools/uber.sh.
#
# It ran in renderer.yml ALONE before this step existed, which made it "the one
# lane a green local push has genuinely not run" — a gap that surfaced only
# after the push had already fanned out to the fleet. Running it here closes
# that, at the cost of a container start on every push that has docker.
#
# NO DOCKER IS A DECLINE, NOT A SKIP: it prints what did not run and says so,
# because a hook that stayed silent would let the reader believe the C was
# judged. CI still runs it authoritatively either way.
if command -v docker >/dev/null 2>&1; then
  if ! tools/uber.sh 'make -f lint.mk lint-c-tidy'; then
    cat >&2 <<'EOF'

[pre-push] BLOCKED — clang-tidy findings in hand-authored C.

  see the findings :  tools/uber.sh 'make -f lint.mk lint-c-tidy'

WarningsAsErrors is '*' by design (renderer/.clang-tidy). A finding is FIXED or
the RULE is declined in that config with its reasoning — never a per-site
NOLINT, which is a silenced symptom rather than a decision on the record.
EOF
    exit 1
  fi
else
  printf '\033[33m[pre-push]\033[0m no docker — clang-tidy NOT RUN over hand-authored C (CI will run it)\n' >&2
fi

# The one PROTO-AWARE check in this hook. It is called separately rather than
# folded into `lint` because `lint` means formatting and lint over
# hand-authored code, and a green `lint` should keep meaning exactly that.
#
# It reads the COMMITTED descriptor set, so locally it answers "does the doc
# match what I have generated" — run `make generate` first if you edited
# proto/ and want this to see it. CI closes that gap authoritatively in
# build-and-release.yml, which runs the same target on freshly generated
# descriptors before anything reaches the consumer repos.
if ! make -f lint.mk wire-contract; then
  cat >&2 <<'EOF'

[pre-push] BLOCKED — docs/INTERFACE-CONTRACTS.md no longer describes the protos.

  see the findings :  python3 tools/wire_contract_check.py

Renumbering IS allowed (§10) — what is not allowed is shipping it with a stale
contract. Both consumers assert §9's byte vectors in their wire-parity tests, so
a wrong §9 turns into a red battery in every repo that bumps its pin, with the
cause already pushed. Update the doc to match the descriptor and bump both pins
in lockstep, or revert the proto change.
EOF
  exit 1
fi

# DOCUMENTATION LINT. Also proto-aware, and separate from `wire-contract` for the
# same reason that one is separate from `lint`: they answer different questions.
# wire-contract asks whether INTERFACE-CONTRACTS.md still describes the protos;
# this asks whether every constrained field and enum value carries a description.
#
# A WARNING BLOCKS. That is the whole point of the lane: warnings are what
# accumulate, because a command that prints them and exits 0 leaves CI green and
# nothing ever has to be dispositioned. The two permitted responses are to fix the
# finding or to delete the rule with its reasoning recorded.
#
# It reads the COMMITTED proto-db.edn, so locally it answers "does the doc match
# what I have generated" — run `make docs-docker-generate` first if you edited
# proto/ or a docs page and want this to see it.
if ! make -f lint.mk docs-lint; then
  cat >&2 <<'EOF'

[pre-push] BLOCKED — proto documentation has lint findings.

  see the findings :  make -f lint.mk docs-lint

Every constrained field and every enum value owes a description. A constraint the
reader can already see in the table is not a description — say what the quantity
IS, in what units or frame, and what the bound protects against.

If a finding is genuinely wrong for this repo, DELETE THE RULE in
docs/.protodoc/tools/src/protodoc/lint.clj with the reasoning recorded there. Do
not reach for --allow-warnings to get past a finding: that flag exists for a bulk
regeneration whose findings are triaged in the following commit, and using it here
re-opens the hole this lane was added to close.
EOF
  exit 1
fi

printf '\033[32m[pre-push]\033[0m gates green\n'
exit 0
