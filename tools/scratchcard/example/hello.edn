;; hello.edn — the smallest complete scratch screen.
;;
;; COPY THIS to start. It is the renderer-gen authoring dialect, the same
;; vocabulary renderer/edn/screens/*.edn uses:
;;
;;   :tag     the widget       (:lv_label, :lv_slider, :lv_button, :lv_obj …)
;;   :class   a class string   (tokens + breakpoint prefixes, tailwind-shaped)
;;   :text    label content
;;   :children  nesting
;;   :<widget>_props  the widget's own arm (:slider_props, :bar_props, …)
;;
;; NOT the devcards node shape — `{:type :WIDGET_SLIDER}` is a different
;; vocabulary for the same widgets and this pipeline will refuse it.
;;
;; Seven validation stages run before a byte is emitted: schema, component
;; resolution, semantic validation, asset-path existence, token expansion,
;; font-reference resolution, and proto IR validation. A typo in a class
;; string or a font name is caught by name, not by looking wrong on screen.
{:type :screen
 :events {}

 ;; `bp` and `theme_dark` are the two subjects the renderer drives; the
 ;; composite style variant is bp*2 + theme_dark. Every screen declares them.
 :subjects {:bp {:type :int}
            :theme_dark {:type :int}}

 :tree
 {:tag :lv_obj
  :children
  [{:tag :lv_label
    :class "font-font-heading text-fg-0"
    :text "hello, scratchcard"}

   {:tag :lv_label
    :class "font-font-body text-fg-0"
    :text "edit this file and regenerate"}

   {:tag :lv_slider
    :class "w-120"
    :slider_props {:min_value 0 :max_value 100 :value 65}}]}}
