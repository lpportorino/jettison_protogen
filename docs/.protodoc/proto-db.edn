t system command container", :notes "Container message for all system-level commands"}}, "ser.JonGuiDataLrf" {:id "ser.JonGuiDataLrf", :name "JonGuiDataLrf", :package "ser", :source "jon_shared_data_lrf.proto", :fields [{:number 1, :name "is_scanning", :type :bool} {:number 2, :name "is_measuring", :type :bool} {:number 3, :name "measure_id", :type :int32, :constraints {:gte 0}, :description "Rangefinder measurement sequence ID"} {:number 4, :name "target", :type :message, :type-ref "ser.JonGuiDataTarget", :description "See [[proto/ser.JonGuiDataTarget]]"} {:number 5, :name "pointer_mode", :type :enum, :type-ref "ser.JonGuiDatatLrfLaserPointerModes", :constraints {:defined-only true}, :description "See related enum for valid values"} {:number 6, :name "fogModeEnabled", :type :bool} {:number 7, :name "is_refining", :type :bool} {:number 8, :name "is_continuous_measuring", :type :bool} {:number 9, :name "is_started", :type :bool, :description "Whether the LRF is started."} {:number 10, :name "meteo", :type :message, :type-ref "ser.JonGuiDataMeteo", :description "Local environmental sensor data from the LRF module, providing temperature, humidity, and pressure readings for ballistics calculations and range correction."} {:number 11, :name "scan_mode", :type :int32, :description "Scanning mode frequency setting for continuous rangefinding: 0=off, 1=1Hz, 2=2Hz, 3=4Hz. Controls how frequently the LRF takes distance measurements during scan operations."}], :description "Encapsulates the operational state of a Laser Range Finder (LRF) device, tracking scanning/measuring modes, measurement progress, laser pointer modes, fog mode, refinement status, and targeting data including precise georeferenced measurements with target/observer coordinates and distances.", :interaction {:category :sensor, :ui-pattern :indicator, :feedback :poll-confirm, :purpose "Laser rangefinder measurement data and status", :related-commands ["cmd.Lrf.Measure" "cmd.Lrf.ScanOn" "cmd.Lrf.ScanOff"], :not