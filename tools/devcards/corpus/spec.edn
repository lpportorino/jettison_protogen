 :expect-legend
 {:baseline "the default-state cell — the reference hash for its class/size"
  :distinct
  "manifest-committed state: T2.5 DISTINCTNESS gate asserts hash != the class's default"
  :inert
  "state NOT in the manifest's committed list (or a survey parity pin): T2.5 INERTNESS gate asserts hash == default"
  :probe "combination/coverage cell outside the single-state contract; judged by its :notes"
  :probe-defect
  "POSITIVE probe: the recorded defect flags are EXPECTED; excluded from zero-flag sweeps"
  :probe-pixel-only
  "dump_tree is structurally blind to this cell's failure mode; the PNG/raw-FB oracle is the assertion — keep out of DOM-flag sweeps"}
