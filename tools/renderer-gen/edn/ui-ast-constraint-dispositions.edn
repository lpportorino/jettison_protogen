 "ui.VisibilityBinding.compare"
 {"defined_only" {:disposition :renderer-guard
                  :guard "compare_op_ok"
                  :test "undefined_compare_op_is_refused"
                  :range-over "CompareOp"
                  :rationale "Closed because `compare_holds`'s default is EQUALITY, so an undefined operator did not fail — it silently became `==`, and a control meant to appear ABOVE a threshold appeared only exactly AT it. Guards all four binding classes that share the shape."}}

 "ui.VisibilityBinding.subject"
 {"max_len" {:disposition :nanopb-size
             :rationale "String bound; ui_ast.options carries the nanopb counterpart at 64."}
  "min_len" {:disposition :enforced-elsewhere
             :by "the `references unknown subject` refusal each of the four binding classes raises when find_subject misses"
             :rationale "An empty reference resolves to nothing and the load is refused, loudly — by a clause about resolvability rather than about length."
             :harm "The coincidence ends if an empty-named subject is ever DECLARED: SubjectDeclaration.name carries the same min_len and is NOT enforced, so the two empties would then agree and the reference would resolve."}}

 "ui.WidgetNode.gestures"
 {"max_items" {:disposition :renderer-guard
               :guard "CMD_PATCH_MAX_GESTURES"
               :test "gestures_past_the_declared_bound_is_refused"
               :rationale "FT_POINTER, so the renderer's count check is the whole enforcement. PARTIAL, and the gap is here rather than hidden: the loop counts only cmd-BEARING entries, so a six-entry list whose sixth carries no cmd violates max_items and is admitted. That surplus is inert — a gesture with no template emits nothing — which is why the partial guard is left as it stands."}}

 "ui.WidgetNode.hit_slop"
 {"lte" {:disposition :renderer-guard
         :guard "MAX_HIT_SLOP"
         :test "hit_slop_past_the_declared_bound_is_refused"
         :rationale "Closed for two harms at once. The value reaches LV_DPX's int32 multiply, which overflows for a large one — undefined behaviour, not a big halo. And ext_click_area GROWS the reachable box while hit-testing returns the FIRST hit walking children in reverse, so an oversized slop absorbs presses aimed at earlier siblings, with no pixel and no event to show for it."}}

 "ui.WidgetNode.text"
