# Docker
.docker/

# Snapshot
#jettison-proto-generator-base.tar.gz

# Temporary files
*.tmp
*.bak
*.swp
*.kate-swp
*~

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.iml

# Note: We intentionally include output/ and output-validated/ directories
# to bundle generated files with the repository

# Temporary directories
tmp/
/tmp/protogen*

# tools/uber.sh mounts the repo root as /workspace and sets
# CARGO_HOME=/workspace/.cargo-home, so cargo lanes leave a cache dir here
.cargo-home/

# Claude monitor state (flock locks) — see .claude/rules/monitor-discipline.md
.protogen/

# Clojure CLI classpath cache (tools.deps writes it wherever it is invoked)
.cpcache/

# clj-kondo analysis cache — editors/LSP write it here; lint.mk deliberately
# runs --cache false, so nothing in this repo reads it. Left untracked it makes
# the worktree dirty, and a consumer vendoring this repo as a submodule folds
# worktree bytes into its gate-cache hash: a dirty submodule is fail-closed
# there, so every affected gate re-runs uncached until this is ignored.
# (.clj-kondo/config.edn stays tracked — only the generated cache is ignored.)
.clj-kondo/.cache/

# clang-tidy mining corpus + compile database (transient analysis output)
.mine/
.mine-c*.txt
renderer/compile_commands.json

# compiler depfiles (a stray -MMD invocation drops them anywhere)
*.d

# clang-tidy gate scratch output
.tidy-*.txt

# PDL-R measurement scratch (the reference + harness are committed; runs are not)
tools/devcards/pdl-r-reference/__pycache__/
tools/devcards/pdl-r-reference/frozen_corpus_result.json

# The donation harness's per-fork scratch area (tools/claude/forks.sh). It is
# scratch BY CONTRACT -- release deletes it -- so nothing here may be tracked.
# It was tracked once, and three separate workers tripped over it: release
# deleted base-tree files and then refused its own deletions, a mutation driver
# at an obvious name overwrote a committed script, and `git add -A` swept the
# harness's own test litter into a commit. Ignoring it makes the name mean one
# thing in every clone.
.fork-scratch/
