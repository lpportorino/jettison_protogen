ui.WidgetNode.children          type:FT_CALLBACK
ui.WidgetNode.text              max_size:256
ui.WidgetNode.style_groups      type:FT_CALLBACK
ui.StyleGroup.variants          type:FT_CALLBACK
ui.StyleVariant.properties      type:FT_CALLBACK
ui.StyleProperty.string_value   max_size:64
# Phase 1.4: Event system redesign
# name IS a command-id: a composite command's collect events read
# cmd.<Pkg>.<Command>.collect.<field>, which exceeds 63 for long composites
# (e.g. cmd.Heater.SetAutomaticControlParams). Budget it at 128 for parity with
# CmdSpec.command_id (128) — the same identifier space. The renderer's persistent
# event cache (event_cb_data_t.name in renderer/src/renderer.c) matches this (a
# _Static_assert locks the two), so the full name survives finalize->emit.
# set_subject stays 64: subject names are bounded at 64 EVERYWHERE (the registry,
# SubjectDeclaration.name), so a longer value could never resolve to a subject.
ui.EventBinding.name                max_size:128
ui.EventBinding.set_subject         max_size:64

# R5a: cmd-out pre-encode. root_template holds a full cmd.Root template
# (deterministic envelope + the command leaf in a fixed-width slot); the
# largest measured device template is ~54 B (an NDC command with full-width
# uint64 frame/state times) — 128 is generous headroom. command_id is a
# dotted cmd-id (<=~30 chars). patches is a small bounded INLINE array (an
# NDC x/y pair → 2, or an ROI rubber-band's two corners x1/y1/x2/y2 → 4). The
# HEAVY optional submessages — WidgetNode.gestures (up
# to 9 GestureSpecs), EventBinding.cmd (one CmdSpec) and EventBinding.cmd_by_value
# (up to 16 fixed CmdSpec templates a widget value index-selects) — are FT_POINTER
# (malloc'd only when present), NOT inline: every WidgetNode is stack-decoded
# recursively per tree level (renderer.c children_decode_cb), so an inline
# gestures[9]/cmd/cmd_by_value[16] (~2 KB+) would overflow the WASM C stack on
# deep trees. buf.validate max_items still bounds each at validate time (9 / 16).
# The gestures bound is stated in ui_ast.proto beside the field, with the sum it
# is derived from; nothing here re-derives it.
ui.CmdSpec.command_id               max_size:128
ui.CmdSpec.root_template            max_size:128
ui.CmdSpec.patches                  max_count:8
# FieldPatch.subject names the local subject a PATCH_KIND_SUBJECT_VALUE slot
# reads. 64 matches buf.validate max_len:63 + NUL, and matches every other
# subject-name bound in this file, so a name legal to DECLARE is always legal
# to reference and a longer one is refused LOUDLY by nanopb rather than
# truncated into a lookup that would miss.
#
# IT COSTS NO DECODE STACK, which is the budget the nine max_size:64 bounds
# below are rationed against. FieldPatch lives only inside CmdSpec, and every
# CmdSpec on the wire hangs off an FT_POINTER field (EventBinding.cmd,
# EventBinding.cmd_by_value, WidgetNode.gestures), so it is malloc'd rather
# than placed in the recursive ui_WidgetNode frame. sizeof(ui_WidgetNode) is
# therefore unmoved by this field AND by the patches bound going 4 -> 8; the
# `generated-projection` lane's header records how to re-measure it.
#
# THE RENDERER DOES MIRROR THIS ONE, in cmd_patch_field_t.subject, so it is a
# real static cost there and not only a decode-buffer cost. Resolving to a
# pointer at copy time instead was tried and is UNSOUND: Screen.subjects is
# field 2 and streams after the tree, and both destinations are unstable
# anyway — the cmd_by_value array is freed if a later entry fails to copy, and
# gesture specs are staged in a caller's local array. So this follows
# EventBinding.set_subject exactly: the name is mirrored, the emit resolves at
# fire time, and a deferred queue checks resolvability once at load.
ui.FieldPatch.subject               max_size:64
ui.WidgetNode.gestures              type:FT_POINTER
ui.EventBinding.cmd                 type:FT_POINTER
ui.EventBinding.cmd_by_value        type:FT_POINTER
ui.WidgetNode.bindings          type:FT_CALLBACK
ui.ImageProps.src               max_size:256
ui.DropdownProps.options         max_size:1024
ui.DropdownProps.option_values   max_count:16
ui.RollerProps.options           max_size:512
ui.TextareaProps.placeholder     max_size:256
ui.ButtonMatrixProps.map_str     max_size:1024

# LineProps.points is a STATIC ARRAY, and it should not go back to FT_CALLBACK.
#
# WHAT ACTUALLY WENT WRONG, stated precisely because the tempting story is
# wrong: this field was FT_CALLBACK and NO decode callback was ever installed
# for it, and no apply arm ever read it. nanopb's pb_common.c treats a null
# funcs.decode as "success, but didn't do anything" — it consumes the field and
# returns true — so the points were dropped while the decode reported success
# and the widget rendered empty. That is an OMISSION, not a subtlety.
#
# WHY THE OBVIOUS REPAIR (install a callback) IS NOT THE ONE TAKEN. LineProps is
# a `oneof widget_props` arm, and pb_decode.c's PB_HTYPE_ONEOF memsets the whole
# submessage to zero on arrival expressly so that "any callbacks are set to NULL
# ... because the callbacks might otherwise have values from some other union
# field". So a funcs.decode pre-set on node.widget_props.line_props.points is
# erased before the arm is read, UNLESS the caller has already set which_props
# to this tag. nanopb's own remedy is the `submsg_callback` option, which
# nothing in this tree uses. Of the ten FT_CALLBACK fields this file declared,
# this was the only one inside a oneof arm; the remaining nine are direct fields
# on their own message, which is why a callback works for them and is awkward
# here.
#
# THE STATIC ARRAY IS FREE. `widget_props` is a union whose floor is set by
# ui_ChartProps: union 1244 B, ChartProps 1244 B, ui_Point 8 B, so LineProps at
# 32 points is 264 B — a fifth of a floor it cannot raise, and zero added bytes
# on the recursive decode stack that bounds the nine max_size:64 fields below
# (ui_WidgetNode is 2252 B on wasm32 both before and after; on x86-64 it went
# 2336 -> 2328, i.e. the change SHRANK the host struct).
#
# MEASURE ON THE TARGET — with the specific reason, because a slogan here was
# twice wrong. Sizes, measured on the pinned headers both ways:
#   pb_callback_t   8 B (align 4) wasm32 | 16 B (align 8) x86-64
#   ui_LineProps   12 B           wasm32 | 24 B           x86-64   (PRE-fix)
#   union        1244 B           wasm32 | 1248 B         x86-64   (PRE-fix)
# So while the field was FT_CALLBACK the union differed across ABIs, and the
# cause is pb_callback_t's ALIGNMENT (8 on the host) rounding 1244 up to 1248 —
# not its size. That 1248 is what an earlier host-side measurement of this
# comment reported as if it were the target's number. With the static array
# both ABIs agree at 1244, so the figures above now reproduce either way; the
# discipline still binds the next person who changes a field's type.
#
# The cap is 32 for parity with ChartSeries.values, not because the union
# forces it: the free ceiling is about 154 points, and SEVEN other union
# members sit above LineProps (ChartProps 1244, DropdownProps 1100,
# ButtonMatrixProps 1025, RollerProps 524, ScaleProps 484, TabviewProps 276,
# ImageProps 272) with TextareaProps tied at 264 — so it could not become the
# dominator even if ChartProps shrank.
#
# NOTE the codegen headroom gate fires at 80% of a cap, not at it: with
# max_count 32, an authored line of 26 points already fails emit, so the
# effective authoring ceiling is 25.
ui.LineProps.points              max_count:32

# ── The nine max_size:64 bounds stay 64. Measured; do not re-litigate. ─────
# A uniform widen of all nine to 256 was proposed and REFUSED on measurement:
# StyleProperty.string_value, EventBinding.set_subject, SubjectDeclaration.name,
# SubjectValue.name, VisibilityBinding.subject, BindFormatsEntry.key,
# BindingsEntry.key, BindingsEntry.value, HostProxyProps.proxy_id. The binding
# constraint is the renderer's decode STACK, not the wire.
#
# WHY A STRING BOUND COSTS STACK. ui_WidgetNode is recursive, and every level of
# children_decode_cb (renderer/src/renderer.c) puts one whole ui_WidgetNode plus
# one widget_ctx_t on the C stack. The nine fields split three ways.
#
# TWO of them sit INLINE in ui_WidgetNode, as FIVE buffer instances:
# EventBinding.set_subject (via .event) and VisibilityBinding.subject four times
# over (.visibility, .checked_when, .enabled_when, .color_when.when).
#
# THREE are FT_CALLBACK map entries — BindingsEntry.key/value and
# BindFormatsEntry.key — so they cost nothing in ui_WidgetNode, but the renderer
# MIRRORS them into widget_ctx_t (binding_entry_t / bind_format_entry_t, 4 slots
# each), which is per level too, and again into the STATIC pending_bindings[64]
# pool. A widened wire bound multiplies in all three places.
#
# The remaining FOUR cost 0 per level. StyleProperty.string_value decodes in a
# transient leaf frame; proxy_id sits in the widget_props union that
# DropdownProps.options already dominates; and SubjectDeclaration.name /
# SubjectValue.name are not in ui_WidgetNode at all (Screen.subjects and
# StateUpdate.values are FT_CALLBACK). Of those two only SubjectDeclaration.name
# costs static bytes, in subject_registry[32]; SubjectValue.name is read
# straight off the decoded message (find_subject(sv.name)) and is mirrored
# nowhere. pending_event_subject[32] is NOT theirs — its sole writer copies
# EventBinding.set_subject — so it is that field's static cost, not these.
#
# Widening ALL NINE to 256 therefore moves sizeof(ui_WidgetNode) 2252 -> 3212
# (+5x192) and sizeof(widget_ctx_t) 2232 -> 4536 (+12x192). Those two account
# for the entire +3264 B/level in the table below, which is how the stack cost
# is known to be structural rather than incidental. It also adds 156 KiB of
# STATIC memory: pending_bindings 115712 -> 263168, subject_registry
# 19712 -> 25856, pending_event_subject 2176 -> 8320.
#
# MEASURED — wasm32-wasip1, -O2 -flto; frames from clang -fstack-usage, peaks by
# bisecting renderer/wasm.mk's -Wl,-z,stack-size against decode_limits'
# nesting_at_the_declared_cap_loads_clean (a chain at MAX_DECODE_DEPTH = 32):
#
#   config                    sizeof(ui_WidgetNode)  per level  peak at depth 32
#   all nine at 64 (this file)                2252       4816           <=159232
#   subject-name set at 256                   3212       6544           <=214528
#   all nine at 256                           3212       8080   TRAPS (>262144)
#
# EVERY FIGURE IN THAT TABLE IS A SNAPSHOT, AND AT LEAST TWO COLUMNS HAVE SINCE
# MOVED. Read today's peak from renderer/wasm.mk's stack-size block, which owns
# it, and read the sizeof staleness from docs/NANOPB-FIELD-BOUNDS.md §8.2, which
# owns that: it records the 2252 as measuring 2256 today and says outright that
# the per-level and peak figures move with it. So do NOT treat the two derived
# columns as vouched for either.
#
# WHAT IS KNOWN ABOUT THE PEAK, stated as narrowly as the evidence allows.
# wasm.mk carries <=165888 today against this table's <=159232, and the commit
# that re-bisected it is the one that took CMD_PATCH_MAX_GESTURES from 8 to 9 —
# a plausible contributor, because renderer.c's finalize_widget declares a
# `cmd_gesture_spec_t specs[CMD_PATCH_MAX_GESTURES]` LOCAL in a NON-RECURSIVE
# frame, sized by the compile-time bound rather than by how many specs a surface
# registers.
#
# IT IS NOT THE WHOLE CAUSE, AND NOTHING HERE SHOULD CLAIM IT IS. The bound
# reached 9 in two steps, and the earlier one (5 -> 8) moved no peak figure at
# all. At the 820 B per-entry size renderer/src/cmd_patch.h states, the 8 -> 9
# step accounts for well under half the observed move, leaving a residual larger
# than the part that is explained. wasm.mk says the same thing from the other
# side and declines to guess — its block records that the re-measured peak is
# further above the old one than this tree's own registry growth accounts for,
# and leaves WHEN the old figure went stale unmeasured. Defer to that refusal
# rather than resolving it here; a confident single cause here would make this
# the most assertive of the three documents about a mechanism the other two
# decline to claim.
#
# The rows are kept as the WIDEN STUDY they are: what matters in them is each
# config's cost RELATIVE to the baseline of its own day. What must not be done
# is to read any cell as a current reading, or to recompute one from a fresher
# baseline — they are bisected measurements, not arithmetic, and a recomputed
# one would be a number nobody measured.
#
# The reservation is 262144. The all-nine widen overflows it — decode_limits
# fails 4 of 9 and the at-cap load traps inside LVGL instead of the depth guard
# refusing, which is the exact failure that reservation exists to prevent. That
# OVERFLOW is a measured observation and stands.
#
# THE MARGIN ARITHMETIC IN THE NEXT SENTENCE DOES NOT. It derives a
# non-recursive constant from the two superseded peaks above and predicts how
# narrowly all-nine misses; both inputs have moved, and the sizeof column it
# implicitly rests on has moved too (§8.2 of docs/NANOPB-FIELD-BOUNDS.md). Read
# "narrow, not a landslide" as a claim about the tree of its own day, not this
# one. It is deliberately NOT recomputed here — a fresh number derived from a
# fresher baseline is exactly what the note above forbids, and the honest
# replacement is a re-bisection, not a subtraction.
#
# Both bisected peaks imply the same 5120 B non-recursive constant, and on
# that model all-nine lands near 263680: it misses by only ~1.5 KB. Narrow, not a
# landslide — but the bisected chain is a bare nesting probe, so what it leaves
# unspent is the whole margin every other decode path has to fit in. The two
# KEYS are what push it over: BindingsEntry.key and BindFormatsEntry.key add
# 1536 B per level (49152 B at the cap) and buy nothing — they are LVGL property
# names from the renderer's own closed vocabulary ("text", "value", "checked"),
# not a domain value.
#
# BindingsEntry.value is the one that looks like a key and is not: ui_ast.proto
# calls it "value = subject name" and binding_entry_t.value says the same, so it
# belongs with the four subject-name bounds — a name legal to DECLARE but too
# long to BIND is a wire bug. That five-field set at 256 IS mechanically safe
# (decode_limits 9/9 green, peak 214528 of 262144), but it spends 54% of the
# margin the reservation currently holds. Each byte of the bound costs 288 B at
# the cap (9 buffers x 32 levels): 128 lands near 177664, 192 near 196096.
#
# max_size IS NOT THE ONLY GATE — EXCEPT FOR THREE OF THE NINE, WHERE IT IS.
# max_size only sizes the nanopb C struct; what a producer may legally emit is
# buf.validate max_len in ui_ast.proto. That caps SIX of these at 63:
# StyleProperty.string_value, EventBinding.set_subject, SubjectDeclaration.name,
# SubjectValue.name, VisibilityBinding.subject, HostProxyProps.proxy_id. For
# those six a max_size-only widen is INERT — it spends stack margin and admits
# nothing, because no conforming producer can emit past 63 anyway.
#
# The other three — BindingsEntry.key, BindingsEntry.value, BindFormatsEntry.key
# — carry NO buf.validate at all. `bindings` and `bind_formats` are bare
# map<string, string> declarations with no field options, and nothing constrains
# the generated map entries' key or value. For those three max_size IS the only
# cap, and today it is enforced LOUDLY: nanopb refuses a longer entry outright
# ("string overflow"). So a max_size-only widen there is NOT inert — it is the
# dangerous direction. The over-long value would start decoding and then be
# truncated at 63, silently, by the renderer's hand-declared mirrors
# (binding_entry_t.key/value, bind_format_entry_t.key) in strncpy. Those mirrors
# carry no _Static_assert tying them to the wire — unlike event_cb_data_t.name,
# which renderer.c asserts against ui_EventBinding.name for exactly this failure
# mode. Wiring that same mirror >= wire assert over every mirror listed below
# would make a forgotten one a BUILD failure rather than a silent truncation,
# and is the right follow-up; it is a renderer.c change, not made in this
# documentation-only edit.
#
# A real widen is therefore a coordinated edit set whose shape depends on which
# field: max_len in ui_ast.proto (for the six that have one; for the three map
# entries there is nothing there to move, so adding a cap is a wire-contract
# change in its own right), max_size here, EVERY renderer mirror of the field,
# and a re-run of the bisection. The mirrors are the SEVEN hand-declared
# fixed buffers each fed by a truncating strncpy: subject_entry_t.name,
# pending_event_subject_t.subject, binding_entry_t.key, binding_entry_t.value,
# bind_format_entry_t.key, event_cb_data_t.set_subject (renderer.c:219) and
# proxy_entry_t.id (renderer.c:1872, PROXY_ID_BUF). The last two are the easy
# ones to miss: they are reached from EventBinding.set_subject and
# HostProxyProps.proxy_id rather than from a name field, and neither carries a
# _Static_assert today — renderer.c has exactly two, over event_cb_data_t.name
# and UI_EVENT_TRIGGER_CHARS.

# Phase 1.3: Subject binding
ui.Screen.subjects                       type:FT_CALLBACK
ui.SubjectDeclaration.name               max_size:64
ui.SubjectDeclaration.string_initial     max_size:256
ui.StateUpdate.values                    type:FT_CALLBACK
ui.SubjectValue.name                     max_size:64
ui.SubjectValue.string_value             max_size:256

# Phase 3.1: Conditional visibility
ui.VisibilityBinding.subject             max_size:64

# Phase 1.3: Bind format strings + binding map entry strings
ui.WidgetNode.bind_formats               type:FT_CALLBACK
ui.WidgetNode.BindFormatsEntry.key        max_size:64
ui.WidgetNode.BindFormatsEntry.value      max_size:256
ui.WidgetNode.BindingsEntry.key           max_size:64
ui.WidgetNode.BindingsEntry.value         max_size:64

# Grid track templates: small bounded arrays (LVGL grids in our screens
# stay narrow; the renderer appends LV_GRID_TEMPLATE_LAST within the cap).
ui.WidgetNode.grid_col_dsc       max_count:12
ui.WidgetNode.grid_row_dsc       max_count:12

# Scale demo-parity extensions
ui.ScaleProps.text_src           max_size:256
ui.ScaleProps.sections           max_count:4

# Tabview demo-parity arm
ui.TabviewProps.tab_names        max_count:8 max_size:32

# Chart demo-parity arm: demo max is 3 series x 12 values; bounds carry
# headroom (8 x 32). Static nanopb arrays — the decoded values are COPIED
# into the chart's own y_points by the renderer, so no pool is needed.
ui.ChartProps.series             max_count:8
ui.ChartSeries.values            max_count:32

# Host-proxy arm: stable host-side join key
ui.HostProxyProps.proxy_id       max_size:64

# ── Target-overlay arm: the FOURTH FT_POINTER field, and the first inside a
# `oneof` arm. ────────────────────────────────────────────────────────────────
#
# WHY NOT INLINE, with the crossover MEASURED rather than asserted. `widget_props`
# is a union floored by ui_ChartProps at 1244 B, so an arm SMALLER than that
# costs nothing at all — the LineProps.points block above makes exactly that
# argument for a static array. It applies here too, up to a point:
# ui_TargetBox is 64 B (4 int32 + label[32] + has_color + ui_Color), so an
# inline boxes[N] costs 64N + 8 and stays under the floor only while N <= 19.
# The measured ladder, wasm32-wasip1 with the pinned WASI-SDK:
#
#   shape                       sizeof(props)  union   sizeof(ui_WidgetNode)
#   FT_POINTER (this file)                 16   1244                    2256
#   inline boxes[16]                     1036   1244                    2256
#   inline boxes[32]                     2060   2060                    3072
#   inline boxes[255]                   16332  16332                   17344
#
# Only the last is a landslide: at 255 the per-level decode cost goes 4816 ->
# 19904 and the depth-32 peak 159232 -> 642048 against a 262144 B reservation,
# i.e. 2.45x over. At 32 it fits (peak ~185344) while spending a quarter of the
# margin every other decode path shares. (Those absolute peaks are against the
# baseline of the day this was measured, which has since moved — see the note
# under the nine-bounds table. The 2.45x is a RATIO between two figures from
# one bisection run, so it is what survives; do not re-derive the absolutes
# against a fresher baseline.) So the honest reason for FT_POINTER is
# not that inline cannot work at this bound — it is that the pointer's cost is
# INDEPENDENT of the bound. Raising max_items later then costs 8 B forever
# instead of re-running the -Wl,-z,stack-size bisection.
#
# THE ARM IS INSIDE A ONEOF AND THAT IS SAFE FOR FT_POINTER, unlike FT_CALLBACK
# (the LineProps post-mortem above). pb_decode.c's PB_HTYPE_ONEOF memset is what
# breaks a pre-set funcs.decode; a pointer field has nothing pre-set. Release is
# covered by the SAME pb_release(ui_WidgetNode_fields, …) the decode sites
# already call: pb_release_single_field skips a non-current union arm, then
# recurses into the current arm's submessage and frees its pointer fields.
#
# ui.TargetBox.label COSTS NO DECODE STACK, exactly like ui.FieldPatch.subject:
# every TargetBox is reached through the FT_POINTER above, so its 32-byte buffer
# is malloc'd rather than placed in the recursive ui_WidgetNode frame.
# sizeof(ui_WidgetNode) is unmoved by this whole arm — measured 2256 both before
# and after, which is also the figure the nine-bounds table above should read
# (it says 2252, which was true before WidgetNode.hit_slop; the two derived
# columns beside it, 4816/level and <=159232 at depth 32, are bisected
# measurements and are NOT recomputed from it — and the peak column has since
# moved, for reasons the note under that table records as NOT ESTABLISHED.
# Do not read this parenthesis as ruling hit_slop out of the peak's movement:
# §8.2 of docs/NANOPB-FIELD-BOUNDS.md says the per-level and peak figures move
# WITH the sizeof, so it is a live candidate rather than an excluded one).
#
# max_count IS NOT SET, and must not be: max_count is the STATIC array size,
# meaningless for FT_POINTER, and nanopb allocates whatever the stream declares.
# buf.validate max_items:32 binds the PRODUCER only. The renderer's own
# MAX_TARGET_BOXES is what refuses a crafted .pb, loudly, at apply time.
ui.TargetOverlayProps.boxes      type:FT_POINTER
ui.TargetBox.label               max_size:32

# Tree patches: ops stream through a callback (unbounded op count); each
# op's WidgetNode payload reuses the existing callback machinery.
ui.ScreenPatch.ops               type:FT_CALLBACK
