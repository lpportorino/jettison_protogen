  ;; ── CLASS 2 (:subject) — the card's SUBJECT is text reflow.
  ;;
  ;; :text_wrapped fires on EVERY family, family 0 included, because a WRAP-mode
  ;; label grows rather than clipping and growing needs no padding to go wrong.
  ;; These are the only entries here that name family 0, and they name it because
  ;; the wrap is the card, not a theme artifact.
  "lv_label/default/medium/wrap"
  [{:invariant :text_wrapped :node "lv_label" :families #{0 1 2}
    :kind :subject
    :rationale
     "the card exists to render LV_LABEL_LONG_MODE_WRAP at a width its text exceeds
     — the reflow IS the subject, and removing it would delete what the card proves"
    :owner "jaremko"}]

  "lv_label/default/large/wrap"
  [{:invariant :text_wrapped :node "lv_label" :families #{0 1 2}
    :kind :subject
    :rationale
     "the card exists to render LV_LABEL_LONG_MODE_WRAP at a width its text exceeds
     — the reflow IS the subject"
    :owner "jaremko"}]

  "lv_label/default/medium/symbols"
  [{:invariant :text_wrapped :node "lv_label" :families #{0 1 2}
    :kind :subject
    :rationale
     "a glyph-subset proof card: its subject is which non-ASCII glyphs the compiled
     face carries, and the string is longer than the size's label width, so it
     reflows. Every glyph is drawn, which is the whole assertion"
    :owner "jaremko"}]

