FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PROTOC_VERSION=36.2
ENV GO_VERSION=1.27.1
ENV RUST_VERSION=1.99.0
ENV GRAALVM_VERSION=25.4.4.1.1
ENV GRAALVM_JDK_VERSION=25i4-25.0.4.1.1
ENV NODE_VERSION=26.11.1
ENV NPM_VERSION=12.2.0
ENV MAVEN_VERSION=3.10.0
ENV CLOJURE_CLI_VERSION=1.12.6.1673
ENV WASI_SDK_VERSION=34

# Distribution build tools come from the selected Ubuntu release and its update
# pockets. Application runtimes and measurement libraries are pinned below;
# record the built image digest when reporting results.
RUN for i in 1 2 3; do \
        apt-get update && \
        apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        curl \
        git \
        wget \
        unzip \
        python3 \
        python3-pip \
        python3-venv \
        fonts-dejavu-core \
        gawk \
        jq \
        ninja-build \
        pkg-config \
        libssl-dev \
        libbz2-dev \
        libffi-dev \
        liblzma-dev \
        libreadline-dev \
        libsqlite3-dev \
        libzstd-dev \
        zlib1g-dev \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* \
        && break || sleep 5; \
    done

# Match the GraalVM and GraalWasm Maven release. Innovation releases use a
# Graal release tag and a separate JDK asset version. Install at a stable path
# instead of depending on the archive's internal build-number directory.
RUN ARCH=$(uname -m) && \
    case "$ARCH" in aarch64) GRAALVM_ARCH=aarch64 ;; x86_64) GRAALVM_ARCH=x64 ;; *) exit 1 ;; esac && \
    GRAALVM_ASSET="graalvm-community-jdk-${GRAALVM_JDK_VERSION}_linux-${GRAALVM_ARCH}_bin.tar.gz" && \
    GRAALVM_URL="https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-${GRAALVM_VERSION}" && \
    curl -fsSL "${GRAALVM_URL}/${GRAALVM_ASSET}" -o /tmp/graalvm.tar.gz && \
    curl -fsSL "${GRAALVM_URL}/${GRAALVM_ASSET}.sha256" -o /tmp/graalvm.sha256 && \
    awk '{ print $1 "  /tmp/graalvm.tar.gz" }' /tmp/graalvm.sha256 | sha256sum -c - && \
    mkdir /opt/graalvm && tar -C /opt/graalvm --strip-components=1 -xzf /tmp/graalvm.tar.gz && \
    rm /tmp/graalvm.tar.gz /tmp/graalvm.sha256
ENV JAVA_HOME=/opt/graalvm
ENV PATH=$JAVA_HOME/bin:$PATH

# The generator packages require a current Node runtime. Use the upstream
# release on both supported architectures and verify its published checksum.
RUN ARCH=$(uname -m) && \
    case "$ARCH" in aarch64) NODE_ARCH=arm64 ;; x86_64) NODE_ARCH=x64 ;; *) exit 1 ;; esac && \
    NODE_ASSET="node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_ASSET}" -o "/tmp/${NODE_ASSET}" && \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o /tmp/node-shasums && \
    (cd /tmp && awk -v a="$NODE_ASSET" '$2 == a { print; found=1 } END { exit !found }' node-shasums | sha256sum -c -) && \
    tar -C /usr/local --strip-components=1 -xJf "/tmp/${NODE_ASSET}" && \
    rm "/tmp/${NODE_ASSET}" /tmp/node-shasums && npm install -g "npm@${NPM_VERSION}"

# Install Maven as a standalone tarball rather than the apt `maven` package:
# apt's `maven` depends on `default-jre-headless`, which pulls in a SECOND,
# unused JDK purely as image bloat, since JAVA_HOME/PATH above
# already point every other consumer at GraalVM. The tarball install has no
# such dependency and matches this file's existing Go download shape.
# Maven Central retains versioned binary distributions after new releases.
RUN curl -fsSL --connect-timeout 30 --max-time 300 https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz -o apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && tar -C /opt -xzf apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && rm apache-maven-${MAVEN_VERSION}-bin.tar.gz
ENV PATH=/opt/apache-maven-${MAVEN_VERSION}/bin:$PATH

# Install the Clojure CLI (tools.deps) — the renderer battery's devcards
# corpus runner and the tools/renderer-gen fixture/codegen aliases are all
# `clojure -M:...` invocations (renderer.mk fixtures/harness/oracles), so
# the CLI is as load-bearing here as javac. Installed from the pinned
# upstream release installer (the same versioned-download shape as
# Go/GraalVM above); the pin matches the CI workflows'
# DeLaGuardo/setup-clojure `cli:` pin — bump the two together.
RUN wget -q https://github.com/clojure/brew-install/releases/download/${CLOJURE_CLI_VERSION}/linux-install.sh \
    && chmod +x linux-install.sh \
    && ./linux-install.sh \
    && rm linux-install.sh

# Detect architecture and install Protocol Buffers compiler
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        PROTOC_ARCH="aarch_64"; \
    else \
        PROTOC_ARCH="x86_64"; \
    fi && \
    wget -q https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip \
    && unzip protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip -d /usr/local \
    && rm protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip

# Install Go for the correct architecture
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        GO_ARCH="arm64"; \
    else \
        GO_ARCH="amd64"; \
    fi && \
    wget -q https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz \
    && tar -C /usr/local -xzf go${GO_VERSION}.linux-${GO_ARCH}.tar.gz \
    && rm go${GO_VERSION}.linux-${GO_ARCH}.tar.gz
ENV PATH=/usr/local/go/bin:$PATH
ENV GOPATH=/go
ENV PATH=$GOPATH/bin:$PATH

# Install Rust system-wide in /opt/rust for all users
ENV RUSTUP_HOME=/opt/rust
ENV CARGO_HOME=/opt/rust
RUN curl -s --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal --no-modify-path
ENV PATH=/opt/rust/bin:$PATH
# Make rust directory accessible to all users
RUN chmod -R a+rx /opt/rust

# Build the latest stable Python independently of Ubuntu's system interpreter.
# The source checksum is published on the Python release page. The measurement
# stack and generator packages share this interpreter and exact package pins.
ARG PYTHON_VERSION=3.14.8
ARG PYTHON_SHA256=c2215904f02b175596dc49351585104f4bc20341e1c47378b26a2c274360ce73
RUN curl -fsSL "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" -o /tmp/python.tar.xz \
    && printf '%s  %s\n' "$PYTHON_SHA256" /tmp/python.tar.xz | sha256sum -c - \
    && mkdir /tmp/python-build \
    && tar -C /tmp/python-build --strip-components=1 -xJf /tmp/python.tar.xz \
    && cd /tmp/python-build \
    && ./configure --prefix=/opt/protogen-python --with-ensurepip=install \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/python-build /tmp/python.tar.xz
ENV PATH=/opt/protogen-python/bin:$PATH
RUN python3 -m pip install --no-cache-dir --upgrade pip==26.2.1 \
    && python3 -m pip install --no-cache-dir \
    numpy==2.5.3 \
    scipy==1.18.1 \
    pillow==12.3.0 \
    protobuf==7.36.2 \
    grpcio-tools==1.84.0 \
    mypy-protobuf==5.1.0

# Generator versions and font rasterizer changes land with regenerated output.
# Connect's old generator is not used by any generation leg; protobuf-es now
# supplies service descriptors without that deprecated ES1-only dependency.
RUN npm install -g \
    ts-proto@2.13.0 \
    @bufbuild/protoc-gen-es@2.16.0 \
    @bufbuild/protobuf@2.16.0 \
    @bufbuild/protovalidate@1.3.0 \
    lv_font_conv@1.5.3

# Install Go protobuf plugins
#
# PINNED, and the pin is load-bearing rather than hygienic: generate-protos.sh's
# Go leg runs these two binaries as buf LOCAL plugins, so their versions help
# decide the bytes of output/go that ten consumer repositories vendor. `@latest`
# here meant the generated Go surface changed whenever the image was rebuilt, in
# the one file whose stated job is pinning every toolchain.
#
# THEY ARE NOT THE ONLY IMAGE INPUT TO THOSE BYTES: buf/validate/validate.pb.go
# (and every other leg's copy of buf.validate) is generated from the
# protovalidate clone below, which is pinned in its own block for that reason.
#
# BUMPING EITHER IS A REGENERATION. protoc-gen-go stamps its own version into
# every generated file header, so a bump rewrites all 48 .pb.go files even when
# no proto changed; land the bump and the regenerated output in one change.
ARG PROTOC_GEN_GO_VERSION=v1.36.12
ARG PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION} \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION} \
    && protoc-gen-go --version \
    && protoc-gen-go-grpc --version

# Clone protovalidate for validate.proto definitions — PINNED.
#
# Every leg that honours buf.validate copies validate.proto out of this clone,
# so its commit decides generated bytes that ten consumer repositories vendor.
# Left at default-branch HEAD, the bytes move whenever the image is rebuilt and
# upstream has moved: an image built after upstream 63347b8 (a header-name
# regex fix) regenerated buf/validate/validate.pb.go and every json-descriptor
# carrying that rule, with no change in this repo at all.
#
# The selected stable source release is v1.2.2. Changing it requires regenerating
# every validate-aware leg. Its Git SHA and the generated Go SDK's BSR revision
# are different identities; both have independently verified pins.
ARG PROTOVALIDATE_REF=4baed765070e580226a0a30bf2a357cc027dc1f7
RUN git clone https://github.com/bufbuild/protovalidate.git /opt/protovalidate \
    && git -C /opt/protovalidate checkout --detach "${PROTOVALIDATE_REF}" \
    && test "$(git -C /opt/protovalidate rev-parse HEAD)" = "${PROTOVALIDATE_REF}"

# Install buf CLI
# PINNED. This was `releases/latest`, which is a floating dependency in the one
# file that is meant to be the version pin for every toolchain — and buf is not
# an incidental tool here: it drives the Go leg's codegen and the JSON-descriptor
# build (preferred over protoc precisely because it preserves buf.validate
# annotations), so a silent buf change can move generated output that ten
# consumer repositories vendor.
#
# VERIFIED AGAINST THE RELEASE'S OWN sha256.txt RATHER THAN A LITERAL, because
# this image is built on BOTH architectures — renderer/devcards/lint on x86_64,
# build-and-release on a native ubuntu-22.04-arm runner — and a single hardcoded
# digest would break one of them. The manifest is per-version and therefore
# immutable in practice, and it covers both assets.
#
# `-f` matters: without it curl writes an HTTP error body to the output path, so
# a bad URL yields an executable "buf" that is an HTML page. The checksum would
# catch it, but failing at the fetch names the actual problem.
ARG BUF_VERSION=1.73.0
RUN BUF_ASSET="buf-$(uname -s)-$(uname -m)" \
    && curl -fsSL -o /usr/local/bin/buf \
       "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/${BUF_ASSET}" \
    && curl -fsSL -o /tmp/buf.sha256 \
       "https://github.com/bufbuild/buf/releases/download/v${BUF_VERSION}/sha256.txt" \
    && awk -v a="$BUF_ASSET" '$2 == a { print $1 "  /usr/local/bin/buf"; found = 1 } END { exit !found }' \
       /tmp/buf.sha256 >/tmp/buf.check \
    && sha256sum -c /tmp/buf.check \
    && rm -f /tmp/buf.sha256 /tmp/buf.check \
    && chmod +x /usr/local/bin/buf \
    && buf --version

# Create buf configuration for Java generation with protovalidate
RUN mkdir -p /workspace/buf-config && \
    echo 'version: v2' > /workspace/buf-config/buf.gen.yaml && \
    echo 'plugins:' >> /workspace/buf-config/buf.gen.yaml && \
    echo '  - protoc_builtin: java' >> /workspace/buf-config/buf.gen.yaml && \
    echo '    out: /workspace/output' >> /workspace/buf-config/buf.gen.yaml

# Create a script to add validate import to proto files
RUN echo '#!/bin/bash\n\
file="$1"\n\
if ! grep -q "import.*validate.proto" "$file"; then\n\
  sed -i "/^syntax.*=.*proto3/a\\\nimport \"buf/validate/validate.proto\";" "$file"\n\
fi' > /usr/local/bin/add-validate-import.sh && chmod +x /usr/local/bin/add-validate-import.sh

# Clone and build nanopb for C generation
RUN git clone https://github.com/nanopb/nanopb.git /opt/nanopb \
    && cd /opt/nanopb \
    && git checkout nanopb-0.4.9.2 \
    && cmake . \
    && make
ENV PATH=$PATH:/opt/nanopb/generator

# Note: For C++ proto generation with buf.validate annotations, we don't need
# protovalidate-cc or CEL-C++ in the Docker image. These are only needed at runtime
# by C++ applications that want to validate messages. The annotations are embedded
# in the generated code as field options/extensions by regular protoc.

# WASI-SDK — the wasm32-wasip1 cross-compiler for the renderer battery
# (renderer/wasm.mk builds controls.wasm + reference.wasm) plus its
# version-matched clang-tidy/clang-format (the C lint gate; an apt clang-tidy
# lags the wasm compiler and misfires on C23). Installed the same way this
# file installs Go/GraalVM: a versioned upstream tarball extracted to
# /opt, arch-detected. Deliberately NOT on PATH — renderer/wasm.mk and the C
# gates reference ${WASI_SDK_PATH}/bin explicitly (WASI_SDK ?= /opt/wasi-sdk),
# so nothing apt-provided can ever shadow the pinned cross toolchain.
ENV WASI_SDK_PATH=/opt/wasi-sdk
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        WASI_ARCH="arm64"; \
    else \
        WASI_ARCH="x86_64"; \
    fi && \
    wget -q https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && mkdir -p ${WASI_SDK_PATH} \
    && tar -C ${WASI_SDK_PATH} --strip-components=1 -xzf wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && rm wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && ${WASI_SDK_PATH}/bin/clang --version | head -1 \
    && ${WASI_SDK_PATH}/bin/clang-tidy --version | head -2

# Create workspace directory
WORKDIR /workspace

# Create a simple test to verify all tools are installed
RUN protoc --version \
    && go version \
    && cargo --version \
    && python3 --version \
    && node --version \
    && java --version \
    && mvn --version \
    && clojure --version \
    && protoc-gen-nanopb --version || echo "nanopb version check" \
    && which protoc-gen-go

# AWT font stack for the devcards GALLERY leg. The gallery composes its contact
# sheets with java.awt (text labels via Graphics2D.drawString), and GraalVM's
# libfontmanager.so dlopens libfreetype.so.6 — absent it, `renderer.mk
# gallery-prebuilt` dies with UnsatisfiedLinkError inside this image while CI's
# plain-runner gallery job (which has the system font stack) passes. That split
# is exactly what the "everything runs in the uber container" rule forbids.
# Deliberately a LATE layer: the base apt block sits above the WASI-SDK/GraalVM/
# protoc installs, so amending it would invalidate the entire toolchain cache.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfreetype6 fontconfig \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Pre-warm the Clojure dependency caches ────────────────────────────────────
# WITHOUT THIS THE BATTERY IS NOT HERMETIC. tools/uber.sh runs `--rm` and the
# Clojure caches live INSIDE the container (/root/.m2, /root/.gitlibs), so
# nothing survives a run: every invocation re-resolved the whole Maven tree AND
# re-cloned the `pronto` git dep from github.com. Measured on the shipped image:
# `.m2/repository` and `.gitlibs/_repos` were both EMPTY, and a leg run with
# `--network none` died with "Could not resolve host: github.com".
#
# That is three defects in one: the battery could not run offline, it took a
# hard gate-time dependency on GitHub + Maven Central being up, and it paid a
# full dependency download on every single run. A gate that reaches the network
# is also a gate whose result depends on something outside the tree
# (`hermetic-tests.md`).
#
# Prefetch every project's dependency-bearing aliases. Preserve relative
# local/root sibling edges, and copy the checksum-bound source-only linter JAR
# needed by its local/root declaration. No application source is required.
COPY tools/devcards/deps.edn /prefetch/devcards/deps.edn
COPY tools/renderer-gen/deps.edn /prefetch/renderer-gen/deps.edn
COPY docs/.protodoc/tools/deps.edn /prefetch/protodoc/deps.edn
COPY tools/scratchcard/deps.edn /prefetch/scratchcard/deps.edn
COPY tools/protocol-gen/deps.edn /prefetch/protocol-gen/deps.edn
COPY tools/gate-graph/deps.edn /prefetch/gate-graph/deps.edn
COPY deps.edn /prefetch/root/deps.edn
COPY tools/lint/kondo/deps.edn /prefetch/root/tools/lint/kondo/deps.edn
COPY tools/lint/kondo/clj-kondo-2026.08.04-protogen.1.jar /prefetch/root/tools/lint/kondo/clj-kondo-2026.08.04-protogen.1.jar
RUN cd /prefetch/devcards \
    && clojure -P -M:bindings:run \
    && clojure -P -M:test \
    && cd /prefetch/renderer-gen \
    && clojure -P -M:fixtures \
    && clojure -P -M:codegen \
    && clojure -P -M:morph-fixtures \
    && clojure -P -M:test \
    && cd /prefetch/protodoc \
    && clojure -P -M:run \
    && clojure -P -M:aot:run \
    && clojure -P -M:aot-compile \
    && clojure -P -M:test \
    && cd /prefetch/scratchcard \
    && clojure -P -M:daemon:test \
    && cd /prefetch/protocol-gen \
    && clojure -P -M:test:verify \
    && cd /prefetch/gate-graph \
    && clojure -P -M:shadow:test \
    && cd /prefetch/root \
    && clojure -P -M:kondo:fmt:splint \
    && cd /prefetch/root/tools/lint/kondo \
    && clojure -P -M:test \
    && clojure -P -M:stock:test \
    && rm -rf /prefetch \
    && test -n "$(ls -A /root/.gitlibs/_repos)" \
    && test -n "$(ls -A /root/.m2/repository)"

# ── shellcheck (lint only) ────────────────────────────────────────────────────
# Placed AFTER the dependency prewarm on purpose. shellcheck takes part in no
# build and no generation — it only lints — so nothing below it depends on it,
# and putting it here means a version bump costs one 16 MB layer instead of
# invalidating the multi-minute Clojure prefetch above. CI builds this image
# cold on every run, so the position costs CI nothing either way.
#
# PINNED WITH A CHECKSUM, matching how every other tool here is fetched, and
# then some: the release tarball's sha256 is verified before extraction, so a
# retagged or substituted asset fails the build instead of silently shipping.
ARG SHELLCHECK_VERSION=0.11.0
# PER-ARCH, because this image is built on BOTH architectures and the first
# version of this layer was not. build-and-release runs on a native
# ubuntu-22.04-arm runner, so a hardcoded x86_64 asset installed cleanly, passed
# its checksum, and then died with "Exec format error" on the ARM leg. The buf
# layer below already solved this and this one did not copy it — the checksum was
# multi-arch-blind in exactly the way a single digest always is.
#
# Digests are per-asset rather than fetched from a manifest: shellcheck publishes
# no combined sha256 file, so each is pinned literally and the unsupported-arch
# arm FAILS rather than falling through to a guess.
ARG SHELLCHECK_SHA256_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
ARG SHELLCHECK_SHA256_AARCH64=12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588
RUN SC_ARCH="$(uname -m)" \
    && case "$SC_ARCH" in \
      x86_64) SC_SHA="${SHELLCHECK_SHA256_X86_64}" ;; \
      aarch64) SC_SHA="${SHELLCHECK_SHA256_AARCH64}" ;; \
      *) echo "shellcheck: unsupported architecture '$SC_ARCH'" >&2; exit 1 ;; \
    esac \
    && SC_TAR="shellcheck-v${SHELLCHECK_VERSION}.linux.${SC_ARCH}.tar.xz" \
    && wget -q "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/${SC_TAR}" \
    && printf '%s  %s\n' "$SC_SHA" "$SC_TAR" >sc.sha256 \
    && sha256sum -c sc.sha256 \
    && tar -xJf "$SC_TAR" \
    && install -m 0755 "shellcheck-v${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck \
    && rm -rf "shellcheck-v${SHELLCHECK_VERSION}" "$SC_TAR" sc.sha256 \
    && shellcheck --version

# Pin and prewarm the maintained Python gate tool after all expensive layers.
# The same wrapper verifies release and extracted binary checksums at bootstrap,
# then verifies cached executable bytes on every invocation. The explicit build
# marker covers BuildKit RUN containers that do not expose /.dockerenv.
COPY tools/lint/ruff.sh /tmp/protogen-ruff.sh
ENV RUFF_CACHE_DIR=/opt/protogen-tools/ruff
RUN RUFF_CONTAINER_BUILD=1 bash /tmp/protogen-ruff.sh --version \
    && rm /tmp/protogen-ruff.sh

# Workflow validation and the scratchcard client use these versioned tools.
ARG ACTIONLINT_VERSION=1.7.12
ARG BABASHKA_VERSION=1.13.225
RUN case "$(uname -m)" in \
      x86_64) TOOL_ARCH=amd64; BB_ARCH=amd64 ;; \
      aarch64) TOOL_ARCH=arm64; BB_ARCH=aarch64 ;; \
      *) exit 1 ;; \
    esac \
    && ACTION_ASSET="actionlint_${ACTIONLINT_VERSION}_linux_${TOOL_ARCH}.tar.gz" \
    && ACTION_URL="https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}" \
    && curl -fsSL "${ACTION_URL}/${ACTION_ASSET}" -o /tmp/actionlint.tar.gz \
    && curl -fsSL "${ACTION_URL}/actionlint_${ACTIONLINT_VERSION}_checksums.txt" -o /tmp/actionlint.checksums \
    && awk -v a="$ACTION_ASSET" '$2 == a { print $1 "  /tmp/actionlint.tar.gz"; found=1 } END { exit !found }' /tmp/actionlint.checksums | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/actionlint.tar.gz actionlint \
    && BB_ASSET="babashka-${BABASHKA_VERSION}-linux-${BB_ARCH}-static.tar.gz" \
    && BB_URL="https://github.com/babashka/babashka/releases/download/v${BABASHKA_VERSION}" \
    && curl -fsSL "${BB_URL}/${BB_ASSET}" -o /tmp/babashka.tar.gz \
    && curl -fsSL "${BB_URL}/${BB_ASSET}.sha256" -o /tmp/babashka.sha256 \
    && awk '{ print $1 "  /tmp/babashka.tar.gz" }' /tmp/babashka.sha256 | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/babashka.tar.gz bb \
    && rm /tmp/actionlint.tar.gz /tmp/actionlint.checksums /tmp/babashka.tar.gz /tmp/babashka.sha256 \
    && actionlint --version \
    && bb --version

# No ENTRYPOINT on the base image: `docker run <img> <cmd>` must run <cmd>
# directly (make, protoc, …) — that is exactly what the renderer battery and any
# hand-rolled base run depend on. Ubuntu's default CMD ["/bin/bash"] still
# gives an interactive shell for a bare `docker run <img>`. The MAIN image
# (Dockerfile) sets its own bash ENTRYPOINT for generate-protos.sh's `-c` flow.
