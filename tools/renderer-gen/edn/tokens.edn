;; tokens.edn — LVGL design token system (military/tactical theme)
;;
;; Three-layer architecture: primitives → semantic → (class usage)
;; Values are LVGL-native: integers for pixels, hex strings for colors,
;; 0-255 for opacity. No CSS units.
{;; ═══════════════════════════════════════════════════════════════════
 ;; LAYER 1: PRIMITIVES — Raw values, no semantic meaning.
 ;; ═══════════════════════════════════════════════════════════════════
 :colors {;; Dark theme base (deep purple-black)
          :base-black "#0A0A12"
          :base-dark "#12121F"
          :base-mid "#1E1E2E"
          :base-light "#2A2A3E"
          ;; Dark edge tone — light enough that a card border clears the 3:1
          ;; non-text floor against EVERY pinned dark fill, which is four and
          ;; not two: surface-1 3.99:1, surface-2 3.52:1, surface-overlay
          ;; 4.24:1, pressed-surface 3.01:1. The retired "#6B6B8A" cleared the
          ;; first three and measured 2.73:1 on pressed-surface, and the
          ;; retired "#3A3A52" before it measured 1.68:1 on surface-1.
          :base-edge "#717290"
          ;; Light theme base (tactical olive)
          :olive-0 "#F0F0E8"
          :olive-50 "#E0E0D4"
          :olive-100 "#D0D0C0"
          :olive-200 "#C0C0A8"
          ;; :olive-400 = light EDGE tone, clearing the non-text 3:1 floor on
          ;; all four pinned light fills: surface-1 4.20:1, surface-2 3.58:1,
          ;; and 3.02:1 on BOTH surface-overlay and pressed-surface, which ship
          ;; the same rung. The retired "#70705A" measured 2.73:1 on that
          ;; shared rung — invisible while the modal overlay was translucent,
          ;; because the blend gave the border accidental headroom; :olive-500 = the light DIMMEST-LEGIBLE TEXT
          ;; tone, which is both :fg-2 and — since the ladder went to three
          ;; rungs — the disabled/placeholder tone (see :disabled-fg). Two
          ;; tokens because border and text carry DIFFERENT contrast floors —
          ;; the retired :olive-300 ("#8A8A70") served both roles and could not
          ;; clear either.
          :olive-400 "#6A6954"
          ;; DERIVED: the LIGHTEST emittable colour at the retired "#585846"'s
          ;; own hue (107.5) and chroma (0.028) clearing MIL-STD-1472H
          ;; 5.2.2.7's 6:1 against the DARKEST FILL a light-theme label can sit
          ;; on. That fill is :pressed-surface and :surface-overlay, which SHARE
          ;; the value "#C0C0A8" — and it is NOT :surface-2 ("#D0D0C0"), which
          ;; is lighter and would bless a tone that fails where it lands.
          ;; LIGHTEST, not darkest: light-mode dimming moves AWAY from the
          ;; surface, so the minimal repair is the highest lightness that still
          ;; clears. L 0.4550 -> 0.3520, giving 6.04:1 on the binding fill and
          ;; 9.75/8.40/7.16:1 on surface-0/1/2; the retired value measured
          ;; 3.91:1 there. Hue and chroma are untouched because WCAG contrast is
          ;; a LUMINANCE ratio — chroma does not enter it, so only lightness can
          ;; repair a contrast failure.
          :olive-500 "#3D3C2B"
          :olive-fg-0 "#1A1A28"
          ;; DERIVED BY PLACEMENT, not by a floor of its own — and that is the
          ;; whole shape of the middle rung. :olive-500 below it already clears
          ;; the governing floor on every fill, so every tone darker than that
          ;; clears it too and the floor fixes nothing here. What fixes this
          ;; value is WHERE it sits between :olive-fg-0 and :olive-500: the
          ;; emittable colour at the retired "#404050"'s own hue (285.0) and
          ;; chroma (0.027) that MAXIMISES THE SMALLER of its two neighbouring
          ;; OKLCH-L gaps. L 0.3779 -> 0.2886, leaving gaps of 0.0639 above and
          ;; 0.0633 below. The retired value measured 5.49:1 on the binding
          ;; fill — under floor, while reading as comfortable on surface-1.
          :olive-fg-1 "#2A2938"
          ;; Accent palette
          :violet-dim "#6B4FA0"
          :violet "#8B5CF6"
          :violet-bright "#A78BFA"
          :violet-deep "#7C3AED"
          ;; The two ACCENT-FILL poles, derived rather than picked: same hue
          ;; (262 deg) and saturation as :violet-deep, moved only in lightness
          ;; until white-on-fill (light) and dark-on-fill (dark) each clear
          ;; §6.2's governing 6:1. See :accent-bg for why the pair must split.
          :violet-pale "#B18AF4"
          :violet-abyss "#5C14D7"
          :cyan "#22D3EE"
          :cyan-dim "#0E7490"
          :cyan-deep "#0891B2"
          :amber "#F59E0B"
          :amber-deep "#D97706"
          :red "#EF4444"
          :green "#10B981"
          ;; Media scrubber "played" position blue (see :media-accent).
          ;;
          ;; NOT DERIVED, AND SAYING SO IS THE POINT. This value is GitHub
          ;; Primer's accent blue. It reached this file by being PROMOTED from
          ;; an inline devcards literal to a named primitive "so the media hue
          ;; has one home" — and giving a foreign design system's colour a home
          ;; here made it look like it came off the same ladder as every token
          ;; around it. It did not. Promotion is not derivation: a token needs a
          ;; REASON for its value, not just a single home, and this one has no
          ;; reason beyond where it was copied from.
          ;;
          ;; Left at its value ON PURPOSE, because the honest fix is not local.
          ;; Measured: h 258.3, which is 34.7 deg from :accent-bg (293.0) and
          ;; 35.2 deg from :checked-accent (223.1) — confusable with both. But
          ;; 258 is very nearly the MIDPOINT of the 70-degree gap those two
          ;; leave, so no other hue in that gap does better; the accent space is
          ;; full, and separating the media hue means moving the accents. That
          ;; is the locked-lightness-ladder task's solve, not a value this
          ;; change can pick without pre-empting it. What is fixed here is the
          ;; false impression of provenance, which is what actually misleads.
          :media-blue "#2F81F7"
          ;; Text colors
          :fg-white "#E8E8F0"
          ;; DERIVED BY PLACEMENT, not by a floor of its own. :fg-dim below it
          ;; already clears the governing floor on every fill, so every tone
          ;; brighter than that clears it too and the floor fixes nothing here.
          ;; What fixes this value is WHERE it sits between :fg-white and
          ;; :fg-dim: the emittable colour at the retired "#9898B0"'s own hue
          ;; (285.4) and chroma (0.035) that MAXIMISES THE SMALLER of its two
          ;; neighbouring OKLCH-L gaps. L 0.6877 -> 0.8367, leaving gaps of
          ;; 0.0966 above and 0.0971 below, against 0.2456 / 0.0586 before —
          ;; the ladder was top-heavy, with three rungs crowded into its dim
          ;; end. The retired value measured 4.97:1 on the binding fill.
          :fg-muted "#C6C7E0"
          ;; The DIMMEST LEGIBLE dark tone: :fg-2, and — since the ladder went
          ;; to three rungs — the disabled and placeholder tone as well (see
          ;; :disabled-fg for why the fourth rung cannot exist).
          ;;
          ;; DERIVED: the dimmest emittable colour at the retired "#8686A0"'s
          ;; own hue (285.2) and chroma (0.039) clearing MIL-STD-1472H
          ;; 5.2.2.7's 6:1 against the LIGHTEST FILL a dark-theme label can sit
          ;; on. THAT FILL IS :pressed-surface ("#2A2A3E", wcag-Y 0.0250), NOT
          ;; :surface-2 ("#1E1E2E", 0.0140): the binding fill is whichever fill
          ;; is closest in luminance to the text, and it is not in the surface-*
          ;; ladder at all. A derivation scoped to surface-* blesses a tone that
          ;; fails where it lands, which is what the retired disabled tone did.
          ;; L 0.6291 -> 0.7397, giving 6.02:1 on the binding fill and
          ;; 8.48/7.98/7.05:1 on surface-0/1/2; the retired value measured
          ;; 3.96:1 there. Hue and chroma are unchanged because WCAG contrast is
          ;; a LUMINANCE ratio — only lightness can repair a contrast failure.
          :fg-dim "#A7A8C3"}
 :fonts {:b612mono-bold-12 {:family "b612mono_bold" :size 12}
         :b612mono-bold-14 {:family "b612mono_bold" :size 14}
         :b612mono-bold-16 {:family "b612mono_bold" :size 16}
         :b612mono-bold-18 {:family "b612mono_bold" :size 18}
         :b612mono-bold-20 {:family "b612mono_bold" :size 20}
         :b612mono-bold-26 {:family "b612mono_bold" :size 26}
         :orbitron-bold-22 {:family "orbitron_bold" :size 22}
         :orbitron-bold-28 {:family "orbitron_bold" :size 28}
         :orbitron-bold-32 {:family "orbitron_bold" :size 32}}
 :spacing {0 0 1 2 2 4 3 8 4 12 5 16 6 20 8 24 10 32 12 40}
 ;; THE RADIUS RULE (theme + authoring): PANEL tier (cards, containers,
 ;; host_proxy frames) rounds with :radius-card -> :lg = 4px; CONTROL tier
 ;; (buttons, form controls: dropdown/textarea/spinbox, checkbox indicator)
 ;; rounds with :radius-default / :radius-button -> :sm = 2px. Stock LVGL's
 ;; RADIUS_DEFAULT=12px/btn 16px is what made small chips render as pills.
 ;; :circle is LVGL's own LV_RADIUS_CIRCLE (lv_draw_rect.h) — a SENTINEL, not a
 ;; length: the draw path tests for this exact value and rounds to a full pill
 ;; whatever the box measures. :full is an ordinary very-large radius that LVGL
 ;; clamps to half the shorter side, so the two are not interchangeable and a
 ;; reader must not "tidy" one into the other.
 :radii {:circle 32767 :full 9999 :lg 4 :md 2 :none 0 :sm 2 :xl 8}
 :opacity {:full 255 :heavy 200 :light 100 :medium 128 :subtle 50 :transparent 0}
 :shadows {:lg {:opa 0 :spread 0 :width 0}
           :md {:opa 0 :spread 0 :width 0}
           :none {:opa 0 :spread 0 :width 0}
           :sm {:opa 0 :spread 0 :width 0}}
 ;; :extra-thick exists for ONE reason: the edited ring must be separable from
 ;; the focus ring by width alone, and one step (2 -> 3) was measured
 ;; insufficient — a VLM review of the committed gallery put the two states'
 ;; ring-to-ring luminance contrast at ~1.05:1 in light mode, leaving a ~1px
 ;; core-width difference as the only cue and calling it not reliably readable
 ;; at a glance. Two steps double the delta. It is deliberately NOT used for
 ;; ordinary borders.
 :border-widths {:extra-thick 4 :medium 2 :none 0 :thick 3 :thin 1}
 :breakpoints {:lg [1024 1280] :md [640 1024] :sm [0 640] :xl [1280 nil]}
 ;; ═══════════════════════════════════════════════════════════════════
 ;; LAYER 2: SEMANTIC TOKENS — Theme-aware, reference primitives.
 ;; ═══════════════════════════════════════════════════════════════════
 :semantic {;; ── Surface colors ──
            :surface-0 {:dark :base-black :light :olive-0}
            :surface-1 {:dark :base-dark :light :olive-50}
            :surface-2 {:dark :base-mid :light :olive-100}
            :surface-overlay {:dark :base-black :light :olive-200}
            ;; ── Foreground / text colors ──
            :fg-0 {:dark :fg-white :light :olive-fg-0}
            :fg-1 {:dark :fg-muted :light :olive-fg-1}
            :fg-2 {:dark :fg-dim :light :olive-500}
            ;; ── Edge / border colors ──
            :edge-0 {:dark :base-edge :light :olive-400}
            :edge-1 {:dark :violet-dim :light :olive-200}
            ;; ── Interactive / accent ──
            ;; SPLIT PER MODE, and the split is FORCED rather than stylistic.
            ;; :violet-deep in both themes was chosen against the 4.5:1 WCAG
            ;; floor (it reached 5.70:1 with pure white). The governing floor
            ;; here is §6.2's 6:1, and NO ink reaches it on that fill: white
            ;; maximises at 5.70 and black gives 3.69, so the FILL had to move
            ;; (docs/UI-QUALITY-CONTRACTS.md §6.8 states exactly this).
            ;;
            ;; Darkening a single shared value fixes the ink and breaks the
            ;; other axis: against the DARK card (surface-1 #12121F) the button
            ;; falls to ~1.6:1 and stops reading as a button at all. So each
            ;; mode takes the pole that clears BOTH — a lighter fill with dark
            ;; ink on dark surfaces, a darker fill with light ink on light ones.
            ;; Measured (ink / vs surface-1): dark 6.39 / 6.90, light 6.79 /
            ;; 6.22, against 4.68 / 3.26 / 4.28 before.
            ;;
            ;; This is the direction :hud-border and :pressed-accent already
            ;; encode, and the mapping Material 3 uses for primary/onPrimary.
            :accent-bg {:dark :violet-pale :light :violet-abyss}
            ;; :accent-text FORKS WITH THE FILL IT SITS ON, and must: it is the
            ;; ink authored compositions put ON :accent-bg (the `:tactical-btn`
            ;; macro is `bg-accent-bg text-accent-text`), so the moment the fill
            ;; stopped being one value the ink could not stay one either. Each
            ;; mode takes fg-0's OPPOSITE pole — the light fill in dark mode
            ;; wants dark ink — which is the same derivation src/theme.c makes
            ;; for the accent ink it owns, from the same two palette entries.
            ;; Measured on the pair: 6.39:1 dark, 6.79:1 light.
            ;;
            ;; It was mode-invariant, and holding it there while :accent-bg
            ;; forked is precisely how a contrast REGRESSION shipped: the fill
            ;; moved, this ink did not, and dark fell 4.68:1 -> 2.21:1 on every
            ;; authored accent button. A token whose ONLY role is ink on a
            ;; forked fill cannot itself be mode-invariant.
            :accent-text {:dark :olive-fg-0 :light :fg-white}
            ;; ── Media ──
            ;; The scrubber "played" position blue — an authored-composition
            ;; colour (theme-family-independent by construction), mode-invariant.
            ;; A named semantic token consumed by the devcards scrubber lego
            ;; through design-tokens.json, promoted from a former inline literal
            ;; so the media hue has one home like every other palette colour.
            :media-accent {:dark :media-blue :light :media-blue}
            ;; The scrubber knob's bright neutral. It sits on the scrubber's own
            ;; authored track, NOT on :accent-bg, so it is genuinely
            ;; mode-invariant like :media-accent beside it — and it is its own
            ;; token for exactly that reason. It used to borrow :accent-text,
            ;; which quietly gave that token two unrelated jobs (accent ink, and
            ;; this) and made the fork above look impossible: forking would have
            ;; broken a knob that never wanted a mode at all. One token, one
            ;; role; the value is unchanged, so no scrubber pixel moves.
            :media-knob :fg-white
            ;; ── Status ──
            :status-success :green
            :status-warning :amber
            :status-error :red
            ;; ── Typography ──
            :font-caption :b612mono-bold-12
            :font-body-sm :b612mono-bold-14
            :font-body :b612mono-bold-16
            :font-body-lg :b612mono-bold-18
            :font-data :b612mono-bold-20
            :font-ttf-probe :b612mono-bold-26
            :font-heading :orbitron-bold-22
            :font-heading-lg :orbitron-bold-28
            :font-heading-xl :orbitron-bold-32
            ;; ── Spacing ──
            :spacing-xs 1
            :spacing-sm 2
            :spacing-md 3
            :spacing-lg 5
            :spacing-xl 8
            ;; true zero — positioning frames (host_proxy), never padded cards
            :spacing-none 0
            ;; ── Radii ──
            :radius-default :sm
            :radius-button :sm
            :radius-card :lg
            ;; explicit square — flush/full-bleed surfaces that must OVERRIDE
            ;; the theme's default tier rounding (video frames, edge-to-edge)
            :radius-none :none
            ;; the pill/dot affordance — a radio's indicator, and anything else
            ;; that must read as round at whatever size it lands. Named so an
            ;; authoring surface stops hand-coding LVGL's sentinel.
            :radius-circle :circle
            ;; ── Shadows (zeroed — sharp tactical aesthetic) ──
            :drop-card :none
            :drop-overlay :none
            ;; ── Opacity ──
            :overlay-opa {:dark :heavy :light :medium}
            :disabled-opa :medium
            :zero-opa :transparent
            ;; ── Border widths ──
            :border-width-default :thin
            :border-width-focus :medium
            ;; The EDITED ring's width, and the reason it is its own token
            ;; rather than :border-width-focus reused: it is what separates the
            ;; edited state from the focus ring now that both may paint
            ;; :cyan-dim. A role distinction carried by geometry needs the two
            ;; widths to be independently nameable, or the next edit to one
            ;; silently collapses the pair again. :extra-thick against focus's
            ;; :medium is TWO steps on this ladder, and the second step was
            ;; bought rather than guessed: at one step a VLM review of the
            ;; committed gallery measured the pair at ~1.05:1 ring-to-ring in
            ;; light — a ~1px core-width difference as the sole cue — and
            ;; reported it not reliably readable at a glance.
            ;;
            ;; THAT MEASUREMENT IS EVIDENCE, NOT A CLAIM THIS FILE MAKES.
            ;; Whether a reader resolves two widths is a property of a PANEL
            ;; and an OPERATOR, which `docs/UI-QUALITY-CONTRACTS.md` §0 puts
            ;; outside this repository's reach — the same refusal
            ;; `palette-ladder`'s `:dimmer-than` makes for the tone ladder
            ;; ("IT ORDERS; IT DOES NOT SEPARATE"). What is recorded here is
            ;; that one step was OBSERVED to fail, never that two will succeed;
            ;; the bench and the next review own that.
            :border-width-edited :extra-thick
            ;; ── Interactive states ──
            :pressed-surface {:dark :base-light :light :olive-200}
            :pressed-accent {:dark :violet-dim :light :violet}
            ;; The transient FOCUS ring. Light takes :cyan-dim on exactly the
            ;; measurement the sibling :checked-accent below was moved for —
            ;; cyan-deep (#0891B2) is 2.77:1 on the light surface, under the 3:1
            ;; non-text floor; cyan-dim clears it on surface-0/1/2
            ;; (4.68 / 4.03 / 3.44) — NOT on every pinned surface. The ladder
            ;; pins FOUR: against :surface-overlay light (#C0C0A8) it measures
            ;; 2.90:1, still under the floor. That is stated rather than
            ;; re-solved, because an outline draws OUTSIDE the widget box, so
            ;; the tone it must clear is the CONTAINER's fill, and whether a
            ;; focusable control is ever hosted on a surface-overlay container
            ;; is a composition question this file does not settle. The change
            ;; is directionally an improvement there regardless — the tone it
            ;; replaces measured 1.99:1 on the same surface. That tone was
            ;; already rejected for the
            ;; affordance lane and only this token was left standing on it.
            ;;
            ;; IT MAY SHARE :cyan-dim WITH :checked-accent BECAUSE THE TWO NO
            ;; LONGER RELY ON COLOUR TO DIFFER. Focus and edited were previously
            ;; identical in geometry (both outline, both :border-width-focus wide
            ;; with a :border-width-default pad), so hue was their ONLY
            ;; discriminator and moving focus onto cyan-dim would have collapsed
            ;; them. The edited ring now takes :border-width-edited, so the two
            ;; separate on WIDTH — which holds in both modes, survives greyscale
            ;; and colour-blindness, and does not spend :checked-accent's
            ;; deliberate mode-invariance. In dark they additionally keep
            ;; different hues (:cyan vs :cyan-dim), so dark is strictly better
            ;; off than before rather than merely unchanged.
            :focused-edge {:dark :cyan :light :cyan-dim}
            ;; The checked/edited affordance — the interactive-affordance lane's
            ;; one hue, mode-invariant. Fills the checked state (checkbox/switch
            ;; indicator, roller/dropdown selected band, buttonmatrix checked
            ;; item) and rings the edited state (slider/bar/roller/spinbox/
            ;; textarea). Distinct from brand-violet :accent-bg (value fills,
            ;; pressed) and from the transient :focused-edge focus ring — it
            ;; says "the operator acted on THIS control". :cyan-dim NOT
            ;; :cyan-deep: cyan-deep (#0891B2) sits under floor on the light
            ;; surface (fill 2.77:1 / white-on-fill 3.68:1 vs the 3:1 non-text /
            ;; 4.5:1 text floors); :cyan-dim (#0E7490) clears both floors in
            ;; both modes (fill 4.03:1 light / 3.46:1 dark, white-on-fill
            ;; 5.36:1), and improves on the stock red edited ring it replaces
            ;; (red measured 2.77:1 on the light surface).
            :checked-accent {:dark :cyan-dim :light :cyan-dim}
            ;; The DISABLED text tone — and, since the fade was removed, the
            ;; only thing carrying the disabled signal on a text-bearing
            ;; widget. IT IS THE SAME TONE AS :fg-2. The foreground ladder
            ;; carries THREE rungs, not four, and this is where the fourth
            ;; went; it had its own primitives while :fg-2 sat under the
            ;; governing floor and could not host the role, and that reason
            ;; expired when :fg-2 was moved to clear it.
            ;;
            ;; WHY THREE, AND WHY LIGHT IS WHAT DECIDES IT. Every text tone has
            ;; to clear the governing 6:1 against the fill it lands on, so the
            ;; dim end of the ladder is pinned at the dimmest tone that does;
            ;; :fg-0 pins the bright end. What is left is an OKLCH-L band, and
            ;; the rungs that fit in it are that band divided by the smallest
            ;; gap this palette's own prose calls visible — 0.0586, the gap the
            ;; retired "#9898B0"/"#8686A0" pair spanned and was described with.
            ;; DARK leaves a band of 0.1936, which carries three gaps and so
            ;; FOUR rungs. LIGHT leaves 0.1272, which carries two gaps and so
            ;; three. The rung COUNT is one table serving both themes, so light
            ;; binds and the fourth rung cannot exist. Do not restore it by
            ;; reading the dark figure alone.
            ;;
            ;; WHAT THE MERGE COSTS, said here rather than found later: a label
            ;; already inked :fg-2 shows NO change when it is disabled, because
            ;; the two tones are now one. A :fg-0 label still dims visibly. The
            ;; alternative is a fourth tone the light theme has no room for at
            ;; the governing floor — a legibility failure traded for a state
            ;; affordance, which is the wrong direction for operator-facing
            ;; text.
            ;;
            ;; THIS ROLE IS ALSO A FILL, and moving it moves that pair too: the
            ;; theme draws the disabled roller's selected band in this colour
            ;; with :surface-2 as the ink. That pair goes 6.04:1 -> 7.05:1 dark
            ;; and holds at 7.16:1 light, so the merge improves it.
            ;;
            ;; The NAME lags the ROLE: this is "the dimmest tone still legible
            ;; at the governing floor", which is also what a textarea
            ;; PLACEHOLDER needs, and theme.c authors the placeholder from it
            ;; for exactly that reason. Renaming belongs with the work that
            ;; renumbers these roles.
            :disabled-fg {:dark :fg-dim :light :olive-500}
            ;; ── HUD overlay controls ──
            :hud-border {:dark :violet :light :violet-deep}
            ;; THE OVERLAY IS OPAQUE, and that is a decision rather than a
            ;; default. It was a translucent scrim (:subtle dark / :light
            ;; light), which had a defect no opacity value could reach: the
            ;; dark rung of :surface-overlay IS :base-black, the same rung
            ;; :surface-0 takes, so blending them is the IDENTITY and the scrim
            ;; was exactly invisible in dark — at any opacity.
            ;;
            ;; Raising the opacity all the way does not paper over that; it
            ;; DISSOLVES it, because an opaque layer never blends. No rung has
            ;; to differ from :surface-0, no per-mode reasoning is needed, and
            ;; the dim-versus-lighten question the translucent form forced —
            ;; light dims onto olive-200 while dark could only lighten — stops
            ;; being asked at all.
            ;;
            ;; The behavioural argument is the operator's: a dialog is MODAL,
            ;; so it must be confirmed or dismissed before anything else can be
            ;; touched. Whatever stays visible behind it cannot be ACTED on, so
            ;; a translucent scrim buys only the chance to misread a stale
            ;; readout as live. Nothing behind an opaque panel can be misread.
            ;;
            ;; LATENT WHEN DECIDED: PROP_OPA appeared in ZERO files across both
            ;; trees, so no shipped screen emitted an overlay and this moved no
            ;; golden. It is set now precisely because the first author to
            ;; reach for the token should inherit the decision rather than
            ;; rediscover the invisible-in-dark defect — which would have
            ;; looked correct to anyone reviewing in light mode.
            ;;
            ;; IT IS A TOKEN VALUE AND NOT A STANDARD-LEVEL RULE, and the two
            ;; read as one thing from here. docs/UI-QUALITY-CONTRACTS.md §6.6
            ;; records this decision and still DECLINES to make "if you can
            ;; read it, you should be able to touch it" an invariant every
            ;; ui_ast surface is judged against — so nothing forbids a
            ;; translucent scrim an authored screen puts up for itself.
            :hud-scrim-opa :full
            :hud-pressed-opa {:dark :light :light :medium}
            :border-width-bold :thick}}