FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PROTOC_VERSION=29.2
ENV GO_VERSION=1.23.4
ENV RUST_VERSION=1.97.0
ENV ZIG_VERSION=0.15.2
ENV ZIG_PROTOBUF_VERSION=v3.0.1
ENV GRAALVM_VERSION=25.0.2
ENV MAVEN_VERSION=3.9.16
ENV CLOJURE_CLI_VERSION=1.12.5.1654
ENV WASI_SDK_VERSION=33

# Install base dependencies
# Use retry logic to handle transient repository issues
RUN for i in 1 2 3; do \
        apt-get update && \
        apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        curl \
        git \
        wget \
        unzip \
        python3 \
        python3-pip \
        python3-venv \
        nodejs \
        npm \
        gawk \
        ninja-build \
        pkg-config \
        libssl-dev \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* \
        && break || sleep 5; \
    done

# Install GraalVM CE for JDK 25 (LTS) for the correct architecture — replaces
# apt's openjdk-17-jdk, which cannot run the polyglot/GraalWasm devcard runner
# at all (polyglot 25.0.2 requires a JDK with JVMCI + the Graal compiler;
# stock OpenJDK 17 has neither). Installed the same way this file already
# installs Go/Rust/Zig: a versioned upstream tarball extracted to /opt, never
# a base-image swap — protogen's other dozen toolchains (protoc/go/rust/zig/
# node/python/buf) are Ubuntu-apt-based and stay that way; only the JDK moves.
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        GRAALVM_ARCH="aarch64"; \
    else \
        GRAALVM_ARCH="x64"; \
    fi && \
    wget -q https://github.com/graalvm/graalvm-ce-builds/releases/download/jdk-${GRAALVM_VERSION}/graalvm-community-jdk-${GRAALVM_VERSION}_linux-${GRAALVM_ARCH}_bin.tar.gz \
    && tar -C /opt -xzf graalvm-community-jdk-${GRAALVM_VERSION}_linux-${GRAALVM_ARCH}_bin.tar.gz \
    && rm graalvm-community-jdk-${GRAALVM_VERSION}_linux-${GRAALVM_ARCH}_bin.tar.gz
ENV JAVA_HOME=/opt/graalvm-community-openjdk-${GRAALVM_VERSION}+10.1
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Maven as a standalone tarball rather than the apt `maven` package:
# apt's `maven` depends on `default-jre-headless`, which pulls in a SECOND,
# unused JDK (openjdk-21-jre-headless on ubuntu:24.04 — confirmed via
# `apt-cache depends maven`) purely as image bloat, since JAVA_HOME/PATH above
# already point every other consumer at GraalVM. The tarball install has no
# such dependency and matches this file's existing Go/Zig download shape.
# Pinned to archive.apache.org (not dlcdn.apache.org, which serves only the
# CURRENT release and 404s the moment a version is superseded — the same
# durability reasoning as every other pinned download in this file).
RUN wget -q https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && tar -C /opt -xzf apache-maven-${MAVEN_VERSION}-bin.tar.gz \
    && rm apache-maven-${MAVEN_VERSION}-bin.tar.gz
ENV PATH=/opt/apache-maven-${MAVEN_VERSION}/bin:$PATH

# Install the Clojure CLI (tools.deps) — the renderer battery's devcards
# corpus runner and the tools/renderer-gen fixture/codegen aliases are all
# `clojure -M:...` invocations (renderer.mk fixtures/harness/oracles), so
# the CLI is as load-bearing here as javac. Installed from the pinned
# upstream release installer (the same versioned-download shape as
# Go/Zig/GraalVM above); the pin matches the CI workflows'
# DeLaGuardo/setup-clojure `cli:` pin — bump the two together.
RUN wget -q https://github.com/clojure/brew-install/releases/download/${CLOJURE_CLI_VERSION}/linux-install.sh \
    && chmod +x linux-install.sh \
    && ./linux-install.sh \
    && rm linux-install.sh

# Detect architecture and install Protocol Buffers compiler
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        PROTOC_ARCH="aarch_64"; \
    else \
        PROTOC_ARCH="x86_64"; \
    fi && \
    wget -q https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip \
    && unzip protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip -d /usr/local \
    && rm protoc-${PROTOC_VERSION}-linux-${PROTOC_ARCH}.zip

# Install Go for the correct architecture
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        GO_ARCH="arm64"; \
    else \
        GO_ARCH="amd64"; \
    fi && \
    wget -q https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz \
    && tar -C /usr/local -xzf go${GO_VERSION}.linux-${GO_ARCH}.tar.gz \
    && rm go${GO_VERSION}.linux-${GO_ARCH}.tar.gz
ENV PATH=/usr/local/go/bin:$PATH
ENV GOPATH=/go
ENV PATH=$GOPATH/bin:$PATH

# Install Rust system-wide in /opt/rust for all users
ENV RUSTUP_HOME=/opt/rust
ENV CARGO_HOME=/opt/rust
RUN curl -s --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal --no-modify-path
ENV PATH=/opt/rust/bin:$PATH
# Make rust directory accessible to all users
RUN chmod -R a+rx /opt/rust

# Install Zig for the correct architecture
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        ZIG_ARCH="aarch64"; \
    else \
        ZIG_ARCH="x86_64"; \
    fi && \
    wget -q https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz \
    && tar -C /opt -xJf zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz \
    && ln -s /opt/zig-${ZIG_ARCH}-linux-${ZIG_VERSION} /opt/zig \
    && rm zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz
ENV PATH=/opt/zig:$PATH

# Clone and build protoc-gen-zig from Arwalk/zig-protobuf
RUN git clone https://github.com/Arwalk/zig-protobuf.git /opt/zig-protobuf \
    && cd /opt/zig-protobuf \
    && git checkout ${ZIG_PROTOBUF_VERSION} \
    && zig build
ENV PATH=$PATH:/opt/zig-protobuf/zig-out/bin

# Install Python protobuf dependencies
RUN pip3 install --break-system-packages \
    protobuf \
    grpcio-tools \
    mypy-protobuf

# Install TypeScript/Node dependencies globally
# lv_font_conv is VERSION-PINNED: it rasterizes the committed renderer fonts
# (renderer/src/font_*.c via tools/gen_fonts.sh), so its output must be
# reproducible. 1.5.2 is the newest release whose rasterizer reproduces the
# existing committed glyph bitmaps byte-for-byte; 1.5.3 changed the rasterizer
# (12-30 bytes/font of anti-aliasing drift), which would re-mint every
# font-bearing golden. Bump this pin only in lockstep with a font re-mint.
RUN npm install -g \
    ts-proto \
    @bufbuild/protoc-gen-es \
    @bufbuild/protoc-gen-connect-es \
    @bufbuild/protobuf \
    @bufbuild/protovalidate \
    lv_font_conv@1.5.2

# Install Go protobuf plugins
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@latest \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest

# Clone protovalidate for validate.proto definitions
RUN git clone https://github.com/bufbuild/protovalidate.git /opt/protovalidate

# Install buf CLI
RUN curl -sSL "https://github.com/bufbuild/buf/releases/latest/download/buf-$(uname -s)-$(uname -m)" \
    -o /usr/local/bin/buf && \
    chmod +x /usr/local/bin/buf

# Create buf configuration for Java generation with protovalidate
RUN mkdir -p /workspace/buf-config && \
    echo 'version: v2' > /workspace/buf-config/buf.gen.yaml && \
    echo 'plugins:' >> /workspace/buf-config/buf.gen.yaml && \
    echo '  - protoc_builtin: java' >> /workspace/buf-config/buf.gen.yaml && \
    echo '    out: /workspace/output' >> /workspace/buf-config/buf.gen.yaml

# Create a script to add validate import to proto files
RUN echo '#!/bin/bash\n\
file="$1"\n\
if ! grep -q "import.*validate.proto" "$file"; then\n\
  sed -i "/^syntax.*=.*proto3/a\\\nimport \"buf/validate/validate.proto\";" "$file"\n\
fi' > /usr/local/bin/add-validate-import.sh && chmod +x /usr/local/bin/add-validate-import.sh

# Clone and build nanopb for C generation
RUN git clone https://github.com/nanopb/nanopb.git /opt/nanopb \
    && cd /opt/nanopb \
    && git checkout 0.4.9 \
    && cmake . \
    && make
ENV PATH=$PATH:/opt/nanopb/generator

# Note: For C++ proto generation with buf.validate annotations, we don't need
# protovalidate-cc or CEL-C++ in the Docker image. These are only needed at runtime
# by C++ applications that want to validate messages. The annotations are embedded
# in the generated code as field options/extensions by regular protoc.

# WASI-SDK — the wasm32-wasip1 cross-compiler for the renderer battery
# (renderer/wasm.mk builds controls.wasm + reference.wasm) plus its
# version-matched clang-tidy/clang-format (the C lint gate; an apt clang-tidy
# lags the wasm compiler and misfires on C23). Installed the same way this
# file installs Go/Zig/GraalVM: a versioned upstream tarball extracted to
# /opt, arch-detected. Deliberately NOT on PATH — renderer/wasm.mk and the C
# gates reference ${WASI_SDK_PATH}/bin explicitly (WASI_SDK ?= /opt/wasi-sdk),
# so nothing apt-provided can ever shadow the pinned cross toolchain.
ENV WASI_SDK_PATH=/opt/wasi-sdk
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        WASI_ARCH="arm64"; \
    else \
        WASI_ARCH="x86_64"; \
    fi && \
    wget -q https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && mkdir -p ${WASI_SDK_PATH} \
    && tar -C ${WASI_SDK_PATH} --strip-components=1 -xzf wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && rm wasi-sdk-${WASI_SDK_VERSION}.0-${WASI_ARCH}-linux.tar.gz \
    && ${WASI_SDK_PATH}/bin/clang --version | head -1 \
    && ${WASI_SDK_PATH}/bin/clang-tidy --version | head -2

# Create workspace directory
WORKDIR /workspace

# Create a simple test to verify all tools are installed
RUN protoc --version \
    && go version \
    && cargo --version \
    && python3 --version \
    && node --version \
    && java --version \
    && mvn --version \
    && clojure --version \
    && zig version \
    && protoc-gen-nanopb --version || echo "nanopb version check" \
    && which protoc-gen-go \
    && which protoc-gen-zig

# AWT font stack for the devcards GALLERY leg. The gallery composes its contact
# sheets with java.awt (text labels via Graphics2D.drawString), and GraalVM's
# libfontmanager.so dlopens libfreetype.so.6 — absent it, `renderer.mk
# gallery-prebuilt` dies with UnsatisfiedLinkError inside this image while CI's
# plain-runner gallery job (which has the system font stack) passes. That split
# is exactly what the "everything runs in the uber container" rule forbids.
# Deliberately a LATE layer: the base apt block sits above the WASI-SDK/GraalVM/
# protoc installs, so amending it would invalidate the entire toolchain cache.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libfreetype6 fontconfig \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Pre-warm the Clojure dependency caches ────────────────────────────────────
# WITHOUT THIS THE BATTERY IS NOT HERMETIC. tools/uber.sh runs `--rm` and the
# Clojure caches live INSIDE the container (/root/.m2, /root/.gitlibs), so
# nothing survives a run: every invocation re-resolved the whole Maven tree AND
# re-cloned the `pronto` git dep from github.com. Measured on the shipped image:
# `.m2/repository` and `.gitlibs/_repos` were both EMPTY, and a leg run with
# `--network none` died with "Could not resolve host: github.com".
#
# That is three defects in one: the battery could not run offline, it took a
# hard gate-time dependency on GitHub + Maven Central being up, and it paid a
# full dependency download on every single run. A gate that reaches the network
# is also a gate whose result depends on something outside the tree
# (`hermetic-tests.md`).
#
# Only the deps.edn files are copied — neither declares a `:local/root`, so no
# source is needed to resolve — which also keeps this layer cache-friendly: it
# re-runs when a DEPENDENCY changes, not when code changes. `-P` prepares the
# classpath (download + clone) without running anything.
#
# Adding an alias to ANY of these deps.edn files obliges adding it here — and so
# does adding a battery lane that drives a TOOL not listed here at all. The
# protodoc tools were the second case: `renderer.mk manifests-proto-db` gates the
# proto-db-derived manifests by re-emitting them, which runs docs/.protodoc/tools,
# whose deps were not prefetched. That lane downloaded from clojars on every cold
# image — the exact defect this layer exists to prevent, reintroduced through a
# tool rather than an alias.
COPY tools/devcards/deps.edn /prefetch/devcards/deps.edn
COPY tools/renderer-gen/deps.edn /prefetch/renderer-gen/deps.edn
COPY docs/.protodoc/tools/deps.edn /prefetch/protodoc/deps.edn
RUN cd /prefetch/devcards \
    && clojure -P -M:bindings:run \
    && clojure -P -M:test \
    && cd /prefetch/renderer-gen \
    && clojure -P -M:fixtures \
    && clojure -P -M:codegen \
    && clojure -P -M:morph-fixtures \
    && clojure -P -M:test \
    && cd /prefetch/protodoc \
    && clojure -P -M:run \
    && clojure -P -M:aot:run \
    && clojure -P -M:aot-compile \
    && clojure -P -M:test \
    && rm -rf /prefetch \
    && test -n "$(ls -A /root/.gitlibs/_repos)" \
    && test -n "$(ls -A /root/.m2/repository)"

# No ENTRYPOINT on the base image: `docker run <img> <cmd>` must run <cmd>
# directly (make, protoc, …) — that is exactly what the renderer battery and any
# hand-rolled base run depend on. ubuntu:24.04's default CMD ["/bin/bash"] still
# gives an interactive shell for a bare `docker run <img>`. The MAIN image
# (Dockerfile) sets its own bash ENTRYPOINT for generate-protos.sh's `-c` flow.