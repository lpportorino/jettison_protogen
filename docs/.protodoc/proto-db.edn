d_cmd_cv.proto", :fields [], :description "Disables the AI-powered computer vision recognition mode, stopping automatic object detection and classification in the video feed. Paired with [[proto/cmd.CV.RecognitionModeEnable]]; the two back a single toggle rather than two independent buttons.\n\nThe readback is `recognition_mode` (#23) on [[proto/ser.JonGuiDataSystem]], which goes `false` once this command is applied. That is the only recognition flag in the schema — [[proto/ser.JonGuiDataCV]] carries none, so a consumer reflecting this toggle reads the SYSTEM state message and not the CV one.", :interaction {:category :settings, :ui-pattern :toggle, :feedback :fire-and-forget, :purpose "Disables computer vision object recognition mode", :related-commands ["cmd.CV.RecognitionModeEnable"], :notes "Stops CV-based object detection and recognition"}}, "cmd.HeatCamera.SetDDELevel" {:id "cmd.HeatCamera.SetDDELevel", :name "SetDDELevel", :package "cmd.HeatCamera", :source "jon_shared_cmd_heat_camera.proto", :fields [{:number 1, :name "value", :type :int32, :constraints {:lte 100, :gte 0}, :description "Percentage value (0-100)", :interaction {:semantic-type :percentage, :precision 2, :display-format "Level: {value}"}}], :description "Sets the Digital Detail Enhancement (DDE) level for thermal image processing, controlling edge enhancement intensity. Accepts an integer value from 0 to 100 and is typically controlled via a slider UI with fire-and-forget feedback.", :interaction {:category :actuator, :ui-pattern :slider, :feedback :fire-and-forget, :purpose "Sets the DDE (Digital Detail Enhancement) level for thermal image processing", :related-state ["ser.JonGuiDataCameraHeat#dde_level"], :related-commands ["cmd.HeatCamera.ShiftDDE" "cmd.HeatCamera.EnableDDE" "cmd.HeatCamera.DisableDDE"], :preconditions ["Heat camera must be started"], :notes "Adjusts edge enhancement intensity for thermal imagery"}}, "cmd.RotaryPlatform.RotateAzimuthRelative" {:id "cmd.RotaryPlatform.RotateAzimuthRelative", :name "RotateAzimuthRelative", :package "cmd.RotaryPlatform", :source "jon_shared_cmd_rotary.proto", :fields [{:number 1, :name "value", :type :double, :constraints {:lt 180, :gte -180}, :description "Angle value in degrees", :interaction {:semantic-type :angle, :unit "°", :precision 2, :display-format "{value}°"}} {:number 2, :name "speed", :type :double, :constraints {:lte 1, :gte 0}, :description "Movement speed (0.0=stopped, 1.0=maximum)", :interaction {:semantic-type :normalized, :unit "%", :precision 0, :display-format "{value * 100}%"}} {:number 3, :name "direction", :type :enum, :type-ref "ser.JonGuiDataRotaryDirection", :constraints {:defined-only true, :not-in [0]}, :description "Rotation direction", :interaction {:semantic-type :enum-label, :display-format "Direction: {value}"}}], :description "Rotates the rotary platform's azimuth (horizontal orientation) by a relative offset from its current position at a specified speed and direction. The offset value ranges from -180 to 180 degrees with clockwise or counter-clockwise movement.", :interaction {:category :actuator, :ui-pattern :directional-mover, :feedback :fire-and-forget, :purpose "Rotates azimuth axis by a relative offset from current position", :related-state ["ser.JonGuiDataRotary#azimuth" "ser.JonGuiDataRotary#azimuth_speed"], :related-commands ["cmd.RotaryPlatform.RotateAzimuthTo" "cmd.RotaryPlatform.HaltAzimuth" "cmd.RotaryPlatform.RotateElevationRelative"], :preconditions ["Rotary platform must be started"], :notes "Relative movement with speed and direction control"}}, "cmd.HeatCamera.RefreshFxMode" {:id "cmd.HeatCamera.RefreshFxMode", :name "RefreshFxMode", :package "cmd.HeatCamera", :source "jon_shared_cmd_heat_camera.proto", :fields [], :description "Triggers a refresh/reapplication of the current visual effects (FX) mode on the thermal camera. This parameterless fire-and-forget command reinitializes the current FX processing without changing modes, useful after parameter c