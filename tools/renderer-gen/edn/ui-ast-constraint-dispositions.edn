 "ui.EventBinding.cmd_by_value"
 {"max_items" {:disposition :renderer-guard
               :guard "CMD_PATCH_MAX_BY_VALUE"
               :test "cmd_by_value_past_the_declared_bound_is_refused"
               :rationale "FT_POINTER, so nanopb allocates whatever the stream declares and there is no static width to bound it. The renderer's own count check is the whole enforcement, and it equals the declared max_items."}}

 "ui.EventBinding.name"
 {"max_len" {:disposition :nanopb-size
             :rationale "String bound; ui_ast.options carries the nanopb counterpart, budgeted at 128 for parity with CmdSpec.command_id."}
  "min_len" {:disposition :unenforced
             :rationale "An empty name is not rejected anywhere, and the arm that would notice reads it as absence rather than as an error."
             :harm "The event attaches only when name OR set_subject is non-empty, so an empty name with an empty set_subject makes the whole binding VANISH silently; an empty name with a set_subject attaches a control that emits a command with no id."}}

 "ui.EventBinding.set_subject"
 {"max_len" {:disposition :nanopb-size
             :rationale "String bound; ui_ast.options carries the nanopb counterpart, held at 64 because subject names are bounded at 64 everywhere."}}

 "ui.EventBinding.trigger"
 {"defined_only" {:disposition :renderer-guard
                  :guard "event_trigger_defined"
                  :test "undefined_event_trigger_is_refused"
                  :range-over "EventTrigger"
                  :rationale "The switch's default arm is TRIGGER_CLICKED's and CLICKED is the zero enumerator, so an undefined trigger was indistinguishable from the default. Closed because the substitution changes WHICH command reaches the device, and the frame is identical either way."}}

 "ui.FieldPatch.encoding"
 {"defined_only" {:disposition :enforced-elsewhere
                  :by "cmd_patch.c's slot-encoding switch, which LOG_ERRORs `value slot has no encoding` and aborts the emit"
                  :rationale "The refusal exists and is loud, but it lives in the emit path rather than the load path."
                  :harm "The screen LOADS clean and the defect surfaces once per activation, as a command that is not sent — so a control looks wired and does nothing, and the diagnosis is in a log nobody is watching at that moment."}}

 "ui.FieldPatch.kind"
 {"defined_only" {:disposition :enforced-elsewhere
                  :by "cmd_patch.c's patch-kind switch, which LOG_ERRORs `unknown patch kind` and aborts the emit"
                  :rationale "As FieldPatch.encoding: a real refusal, in the emit path."
                  :harm "As FieldPatch.encoding: the load is clean and the command silently fails to be sent at fire time."}}

 "ui.FieldPatch.subject"
