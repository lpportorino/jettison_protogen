;; protogen devcards runner.
;; Public tooling: renders the canonical devcard corpus against the PINNED
;; controls.wasm via GraalWasm and proves the two-ended goldens (schema-validate,
;; raw-framebuffer hash, DOM invariants). REQUIRES GraalVM CE: polyglot ships as
;; plain Maven deps, but without JVMCI + the Graal compiler it interprets the
;; wasm, so the runner hard-fails rather than degrade silently.
{:aliases {;; The bindings path: protogen's own output/java compiled by
           ;; tools/compile-bindings.sh.
           :bindings {:extra-paths ["target/proto-classes"]}
           :run {:main-opts ["-m" "devcards.core"]}
           ;; T2.2 smoke: build all cards + schema-validate + render the
           ;; representative slice (dev/t22_smoke.clj).
           :t22-smoke {:extra-paths ["dev"] :main-opts ["-m" "t22-smoke"]}
           ;; Pure-Clojure shape regression for the dock-panel lego (no wasm):
           ;; empty :stages is a valid identity pipeline; non-vector is rejected.
           :legos-shape-test {:extra-paths ["dev"] :main-opts ["-m" "legos-shape-test"]}
           ;; Read-only probe: which LVGL classes the renderer actually emits
           ;; as dump `type` (the classification table's real key set), and
           ;; what the overlap rule says about the real corpus. Gates nothing.
           :class-census {:extra-paths ["dev"] :main-opts ["-m" "class-census"]}
           ;; Read-only audit: ordered DISABLED pointer dead zones plus
           ;; population accounting and four real-wasm planted cases.
           :deadzone-census
           {:extra-paths ["dev"] :main-opts ["-m" "deadzone-census"]}
           ;; The four-case mutation-sensitive subset, armed in
           ;; renderer.mk's battery without re-running the full census.
           :deadzone-canary
           {:extra-paths ["dev"]
            :main-opts ["-m" "deadzone-census" "--canary-only"]}
           ;; The OVERLAP rule's real-render canary: planted overlapping and
           ;; non-overlapping cases built through fixtures/build-authored-card
           ;; and rendered on the pinned wasm, so the rule is judged against
           ;; the dump vocabulary the renderer EMITS rather than against a
           ;; hand-written map of it. Armed in renderer.mk's battery.
           :overlap-canary
           {:extra-paths ["dev"] :main-opts ["-m" "overlap-canary"]}
           ;; Read-only probe: the EFFECTIVE (glyph, fill) pair a disabled
           ;; widget renders, measured off the framebuffer rather than read
           ;; off the tokens. The opa ban's acceptance instrument — a
           ;; whole-widget opa/recolor re-composites both ends, so only this
           ;; can say whether the authored pair is the rendered one.
           :disabled-pair {:extra-paths ["dev"] :main-opts ["-m" "disabled-pair-probe"]}
           ;; Read-only probe: where a whole-widget fade lands on the real
           ;; corpus, and whether it lands on glyphs. The opa ban's ARMING
           ;; evidence — devcards.opa's docstring quotes its counts, and this
           ;; is how they are re-derived rather than trusted.
           :opa-text-probe {:extra-paths ["dev"] :main-opts ["-m" "opa-text-probe"]}
           ;; Read-only probe: WHERE inside its own box a roller puts the
           ;; selected option, and whether that position moves with the
           ;; selected INDEX. Settles by framebuffer what `lv_roller_label`
           ;; coords alone cannot: a label that scrolls one row per step is
           ;; equally consistent with the selection being pinned to the centre
           ;; and with it sliding to a list boundary.
           ;; Read-only probe: is every colour the renderer DRAWS a value the
           ;; token manifest declares? The arming measurement for the RECOLOR
           ;; arm UI-QUALITY-CONTRACTS §6.7 hands to the static tier.
           :token-conformance {:extra-paths ["dev"] :main-opts ["-m" "token-conformance-probe"]}
           ;; Read-only probe: which (ink, fill) token pairs the sources DECLARE
           ;; TOGETHER, and each one's contrast ratio — the constructive answer
           ;; to UI-QUALITY-CONTRACTS §6.9's "a declared FG x BG cross product is
           ;; neither sound nor complete". Regenerates docs/PROVEN-PAIRS.md.
           ;; Renders NOTHING: pure arithmetic on declared values, so it needs no
           ;; wasm, no bindings and no goldens. It borrows the AUTHORING GRAMMAR
           ;; from tools/renderer-gen (class-string parse, breakpoint precedence,
           ;; the token->C macro table) rather than forking it — a second parser
           ;; would drift from the one the renderer is actually built with. malli
           ;; comes with those namespaces; it is already in the pinned image.
           :proven-pairs {:extra-paths ["dev" "../renderer-gen/src"]
                          :extra-deps {metosin/malli {:mvn/version "0.20.1"}}
                          :main-opts ["-m" "proven-pairs"]}
           :roller-bounds {:extra-paths ["dev"] :main-opts ["-m" "roller-bounds-probe"]}
           ;; Read-only probe: how many bytes of dump_obj's SINGLE shared
           ;; TREE_BUF_SIZE buffer the real corpus consumes. Run before AND
           ;; after any change to the dump's key set — an always-emitted key
           ;; spends headroom on every node of every card, and the overflow
           ;; surfaces as a :dump-truncated finding, not as a build error.
           :dump-size-probe {:extra-paths ["dev"] :main-opts ["-m" "dump-size-probe"]}
           ;; Render-level canaries for the conditional OVERFLOW_VISIBLE
           ;; descend_gate and the pre-parse truncation-suffix contract.
           ;; Unlike a hand-built dump map, both construct real protobuf
           ;; cards, render the wasm and exercise the host membrane.
           :dump-contract-probe
           {:extra-paths ["dev"] :main-opts ["-m" "dump-contract-probe"]}
           ;; Read-only probe: does the dump's `opa` reproduce LVGL's OWN
           ;; accumulation at its RAILS (253 neutral, 2 transparent, MIX2
           ;; chaining)? Adjudicated by framebuffer identity, not by the
           ;; probe's own arithmetic. Exits non-zero on a mismatch.
           :opa-rail-probe {:extra-paths ["dev"] :main-opts ["-m" "opa-rail-probe"]}
           ;; The stimulus instrument for docs/VLM-READBACK-PROTOCOL.md: emits
           ;; the ANSWER KEY for a read-back calibration corpus (high-entropy
           ;; strings loaded with the cockpit confusable set) plus its exact
           ;; entropy. Renders nothing, judges nothing, gates nothing — a
           ;; labelled set is manufactured once and a deterministic producer
           ;; reproduces it forever, which is the only shape §0 allows here.
           :readback-strings {:extra-paths ["dev"] :main-opts ["-m" "readback-strings"]}
           ;; Unit tests for the pure helpers (dump-tree reductions, image
           ;; math). Same pinned runner protodoc's suite uses.
           ;;
           ;; `dev` IS ON THIS CLASSPATH ON PURPOSE. The pure instruments under
           ;; dev/ are hand-authored and lint-gated like everything else, so a
           ;; deftest suite is the right home for their unit proofs — and the
           ;; runner still SCANS only `test` (cognitect.test-runner defaults
           ;; `:dir` to #{"test"}), so nothing in dev/ whose name happens to end
           ;; in -test is collected. dev/ here is reachable, not scanned.
           :test {:extra-paths ["test" "dev"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; GraalWasm in-process (UPL-1.0 chain; the wasm meta-pom pulls
        ;; truffle-runtime). Versions proven in-fleet.
        org.graalvm.polyglot/polyglot {:mvn/version "25.0.2"}
        org.graalvm.wasm/wasm {:extension "pom" :mvn/version "25.0.2"}
        ;; ui.UiAst fixture construction — protogen's own generated Java
        ;; bindings (compiled from output/java by tools/compile-bindings.sh
        ;; into target/proto-classes, wired via :bindings).
        com.google.protobuf/protobuf-java {:mvn/version "4.35.0"}
        ;; UiAst.java references build.buf.validate.ValidateProto at
        ;; descriptor init (ui_ast.proto imports buf/validate/validate.proto)
        ;; — a CLASS-INIT dependency even before any runtime validation; the
        ;; smoke also runs the protovalidate Validator over every fixture
        ;; (the schema end of the two-ended goldens). Same pin the in-fleet
        ;; consumers carry.
        build.buf/protovalidate {:mvn/version "1.2.2"}
        ;; dump_tree DOM parsing + golden manifests
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :paths ["src"]}
