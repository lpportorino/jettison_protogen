ription "Current measured temperature of this heating zone.", :interaction {:semantic-type :temperature, :unit "°C", :precision 1}} {:number 2, :name "applied_voltage_V", :type :float, :constraints {:gte 0}, :description "Currently applied PWM voltage to the heater element.", :interaction {:semantic-type :voltage, :unit "V", :precision 2}} {:number 3, :name "target_voltage_V", :type :float, :constraints {:gte 0}, :description "Target voltage for PWM control to achieve desired temperature.", :interaction {:semantic-type :voltage, :unit "V", :precision 2}} {:number 4, :name "enabled", :type :bool, :description "Whether this heating channel is currently active."}], :description "Status of an individual heater channel. Reports current temperature (°C), applied and target voltages for PWM control, and enabled state.", :interaction {:category :status, :ui-pattern :indicator, :feedback :fire-and-forget, :purpose "Reports the current state of a single heating channel including temperature, PWM voltage control, and enabled status.", :related-commands ["cmd.Heater.SetHeating"]}}, "cmd.DayCamera.SetDigitalZoomLevel" {:id "cmd.DayCamera.SetDigitalZoomLevel", :name "SetDigitalZoomLevel", :package "cmd.DayCamera", :source "jon_shared_cmd_day_camera.proto", :fields [{:number 1, :name "value", :type :double, :constraints {:gte 1}, :description "Numeric value", :interaction {:semantic-type :normalized, :unit "x", :precision 2, :display-format "{value}x"}}], :description "Controls the digital zoom magnification level for the day camera. Accepts a value representing zoom magnification (1x or higher) and operates as a fire-and-forget command with slider UI. Can be synchronized with heat camera digital zoom via a UI sync toggle for coordinated dual-camera operation.", :interaction {:category :actuator, :ui-pattern :slider, :feedback :fire-and-forget, :purpose "Controls digital zoom magnification level for day camera", :related-state ["ser.JonGuiDataCameraDay#digital_zoom_level"], :relat